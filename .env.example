# ═══════════════════════════════════════════════════════════════════════════
# Lilia Food — backend : variables d'environnement
# ═══════════════════════════════════════════════════════════════════════════
#
# La SPÉCIFICATION qui fait foi est `apps/lilia-app/src/config/env.validation.ts`
# (schéma Joi). Ce fichier la documente ; `env-example-parity.spec.ts` vérifie
# que les deux ne divergent pas — une variable ajoutée au schéma sans être
# ajoutée ici fait échouer la suite.
#
# Convention :
#   [REQUIS]      le démarrage échoue sans elle
#   [PROD]        requise uniquement quand NODE_ENV=production
#   [PAWAPAY]     requise uniquement quand PAYMENT_MODE=PAWAPAY
#   [MTN]         requise uniquement quand PAYMENT_MODE=SANDBOX|MTN_PRODUCTION
#   (sinon)       optionnelle, avec un défaut sûr
#
# ⚠️ Ce fichier est VERSIONNÉ et le dépôt est public : il ne contient que des
#    gabarits. Les vraies valeurs vivent dans `.env` (non versionné) et sur
#    Render.

# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | staging | production | test
PORT=3000
WORKER_PORT=8081                     # port du processus de tâches de fond
LOG_LEVEL=                           # fatal|error|warn|info|debug|trace|silent (défaut: info en prod)

# Ce processus exécute-t-il les crons et le dépilage de l'outbox ?
# Défaut `true` — volontairement : un défaut à `false` ferait disparaître en
# silence l'expiration des commandes. Quand le worker est déployé :
#   service web    → RUN_BACKGROUND_JOBS=false
#   service worker → RUN_BACKGROUND_JOBS=true  (ou non défini)
RUN_BACKGROUND_JOBS=true

# Nombre de proxys de confiance devant l'app (Render en place 1). Sans lui,
# `req.ip` vaut l'adresse du load balancer et le rate limiting devient un
# compteur GLOBAL. Ne PAS augmenter pour « voir la vraie IP » : à 2, un appelant
# peut forger son adresse via X-Forwarded-For.
TRUST_PROXY_HOPS=1

# Le trafic passe-t-il OBLIGATOIREMENT par l'edge Cloudflare ?
# Cloudflare écrase `CF-Connecting-IP`, ce qui rend cet en-tête digne de
# confiance — mais SEULEMENT si aucun chemin direct n'existe vers le service.
# Or Render expose toujours un hôte `*.onrender.com` joignable sans passer par
# l'edge. Défaut `false` : la liste blanche d'IP du webhook pawaPay s'appuie
# dessus, et se tromper y signifie « accepter une confirmation de paiement
# forgée ». Ne passer à `true` qu'une fois le chemin direct réellement fermé.
TRUST_CLOUDFLARE_IP_HEADER=false

# Rétention des positions GPS des courses terminées, en jours.
TRACKING_RETENTION_DAYS=30

# ─── Base de données ───────────────────────────────────────── [REQUIS] ────
DATABASE_URL=postgresql://user:password@localhost:5432/lilia_db

# ─── Firebase Admin SDK ──────────────────────────────────────  [REQUIS] ───
# Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVOTRE_CLE_ICI\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_PATH=       # alternative en dev : chemin vers le JSON

# ─── CORS ────────────────────────────────────────────────────── [PROD] ────
# Liste blanche stricte. Le démarrage ÉCHOUE en production sans elle : refléter
# toute origine avec `credentials: true` est une faille (CSRF / exfiltration).
ALLOWED_ORIGINS=https://www.liliafood.com,https://admin.liliafood.com

# ─── Redis ───────────────────────────────────────────────────── [PROD] ────
# REQUIS en production. Sans lui, TROIS contrôles se dégradent EN SILENCE :
# idempotence du checkout, rate limiting partagé, verrous de cron. Le boot
# échoue plutôt que de démarrer à moitié.
REDIS_URL=redis://localhost:6379

# Délais du client Redis, par usage. Vides = valeurs par défaut du code
# (`common/redis/redis-options.ts`) : 3 000 ms métier, 1 500 ms throttler,
# 5 000 ms connexion.
#
# ⚠️ C'est LE levier à poser sur Render quand le RTT Redis dérive, sans attendre
# un redéploiement. Le 16/09/2026, le plafond du throttler (500 ms à l'époque)
# est passé sous le temps de réponse réel (~395 ms) : le rate limiting s'est
# éteint en silence, 338 expirations en 20 h. Les trois variables étaient
# lisibles dans le code et documentées nulle part — c'est-à-dire introuvables
# au moment où elles servaient.
#
# Profil « métier » : idempotence du checkout, verrous de cron. Patient, parce
# qu'échouer ici fait perdre une GARANTIE, pas du confort. [100 – 30000]
REDIS_COMMAND_TIMEOUT_MS=
# Profil « protection » : rate limiting. Doit échouer vite — mais plus tard que
# le chemin nominal, sans quoi il n'échoue pas vite, il échoue toujours. [100 – 30000]
REDIS_THROTTLER_COMMAND_TIMEOUT_MS=
# Établissement de connexion, indépendant des commandes. [100 – 60000]
REDIS_CONNECT_TIMEOUT_MS=
# `true` journalise CHAQUE appel Redis — outil de diagnostic, à éteindre après
# mesure.
REDIS_METRICS_LOG=false

# ─── Cloudinary (images) ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
# PAIEMENTS
# ═══════════════════════════════════════════════════════════════════════════
# MANUAL          virement vers LILIA_PAYMENT_PHONE, un admin confirme
# PAWAPAY         encaissement + reversement automatiques  ← CIBLE PRODUCTION
# SANDBOX         MTN MoMo bac à sable
# MTN_PRODUCTION  MTN MoMo en direct
PAYMENT_MODE=MANUAL

# Plafond de tentatives d'encaissement par commande. Chaque tentative coûte une
# opération facturée ET un push USSD sur le téléphone saisi : sans plafond,
# l'endpoint devient un outil de harcèlement. 0 désactive.
PAYMENT_MAX_ATTEMPTS=3

# Délai au-delà duquel un encaissement dont le prestataire ne sait rien est clos.
PAYMENT_RECONCILIATION_TIMEOUT_MINUTES=15

# Numéros d'encaissement en mode MANUAL. Un client Airtel ne peut pas envoyer
# sur un numéro MTN : renseigner les deux dès qu'Airtel est proposé.
LILIA_PAYMENT_PHONE=+242000000000
LILIA_AIRTEL_PAYMENT_PHONE=

# ─── pawaPay ───────────────────────────────────────────────  [PAWAPAY] ────
PAWAPAY_API_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=votre-jeton-pawapay

# ⚠️ L'UNE DES DEUX EST OBLIGATOIRE en mode PAWAPAY — le démarrage échoue sinon.
#
# Le webhook est fail-closed : sans l'une des deux, il répond 401 à TOUT, aucun
# paiement ne se confirme par sa voie normale, et rien ne l'annonce. C'est
# exactement ce qui s'est produit trois semaines durant (0 callback accepté).
#
# Délai de carence (heures) avant tout reversement vers un compte vendeur
# nouvellement saisi ou modifié (Master Audit v1, F-08). Le vendeur est prévenu
# du changement : un compte administrateur compromis ne peut pas remplacer le
# numéro et virer dans la foulée. 0 désactive.
PAYOUT_ACCOUNT_COOLDOWN_HOURS=24

# Preuve de remise d'une course (Master Audit v1, F-06). `false` pendant la
# transition : le code est vérifié s'il est fourni, sans être exigé. Passer à
# `true` quand toutes les apps livreur installées savent le demander.
DELIVERY_HANDOVER_CODE_REQUIRED=false

# PAWAPAY_PUBLIC_KEY est le dispositif de RÉFÉRENCE : la signature RFC-9421
# prouve l'origine ET l'intégrité du corps, sans rien supposer du réseau.
# PAWAPAY_CALLBACK_IPS n'est qu'un repli, et un repli faible — il dépend de
# TRUST_CLOUDFLARE_IP_HEADER ci-dessus pour lire la bonne adresse.
PAWAPAY_PUBLIC_KEY=
PAWAPAY_CALLBACK_IPS=

# Codes opérateur propres au compte marchand. Ces valeurs par défaut suivent la
# convention <OPERATEUR>_<ISO3> observée ailleurs — elles ne figurent dans
# aucune énumération publique. Les confirmer via GET /v2/active-conf, et les
# vérifier sur `GET /payments/providers` sans redéployer.
PAWAPAY_MTN_PROVIDER=MTN_MOMO_COG
PAWAPAY_AIRTEL_PROVIDER=AIRTEL_COG

# Préfixe du libellé lu par le client dans son SMS de reçu. pawaPay borne
# `customerMessage` à 22 caractères, référence de commande comprise.
PAWAPAY_STATEMENT_PREFIX=LiliaFood

# ─── MTN Mobile Money ──────────────────────────────────────────  [MTN] ────
# ⚠️ MTN_MOMO_BASE_URL est `.required()` hors mode MANUAL : le code a un défaut
#    pointant vers le SANDBOX. L'oublier en MTN_PRODUCTION enverrait les
#    paiements réels vers le bac à sable, sans le moindre message d'erreur.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_WEBHOOK_SECRET=
MTN_MOMO_CALLBACK_URL=https://votre-api.example.com/webhooks/mtn-momo
MTN_MOMO_API_KEY=
MTN_MOMO_API_USER=

# ─── Expiration des commandes impayées ─────────────────────────────────────
# Le stock est réservé au CHECKOUT, pas au paiement : sans expiration, une
# commande abandonnée l'immobilise indéfiniment. Trois seuils, parce que trois
# situations différentes.
ORDER_PAYMENT_TIMEOUT_MINUTES=45          # aucun paiement initié
ORDER_FAILED_PAYMENT_TIMEOUT_MINUTES=10   # après un refus définitif du prestataire
ORDER_PENDING_PAYMENT_TIMEOUT_MINUTES=360 # paiement en attente (mode MANUAL)

# ─── Parrainage ────────────────────────────────────────────────────────────
# Plafond de filleuls récompensés par parrain sur 30 jours glissants :
# l'inscription Firebase est gratuite et illimitée. 0 désactive.
REFERRAL_MAX_REWARDS_PER_MONTH=10

# ─── SMS Infobip ───────────────────────────────────────────────────────────
# ⚠️ INFOBIP_SENDER doit être un sender ID ENREGISTRÉ pour le Congo (+242).
#    Le numéro d'essai gratuit fourni par Infobip (un long number britannique)
#    ne livre QU'AUX destinataires pré-vérifiés dans le portail, et rejette tout
#    le reste — en répondant HTTP 200. Vérifier les envois réels via
#    `GET /sms/1/reports`, jamais au seul code de retour.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=                    # ex: xxxxx.api.infobip.com (propre au compte)
INFOBIP_SENDER=LiliaFood

# ─── E-mails Resend ────────────────────────────────────────────────────────
# ⚠️ RESEND_SENDER_EMAIL doit être sur un domaine VÉRIFIÉ dans Resend
#    (https://resend.com/domains). Sinon l'API répond 403 et les invitations
#    vendeur n'arrivent jamais.
RESEND_API_KEY=
RESEND_SENDER_EMAIL=noreply@liliafood.com
RESEND_SENDER_NAME=Lilia Food

# ─── Invalidation du cache du site public ──────────────────────────────────
# Après une écriture au catalogue, le backend demande au site d'oublier la carte
# du vendeur. Les deux variables sont SOLIDAIRES : si l'une manque, le service
# se tait et le cache expire de lui-même (mode dégradé légitime).
# Le secret protège une route PUBLIQUE du site : sans lui, n'importe qui
# purgerait le cache en boucle et ferait du site un amplificateur de charge.
WEB_REVALIDATE_URL=https://www.liliafood.com/api/revalidate
WEB_REVALIDATE_SECRET=               # minimum 16 caractères

# ─── Sentry ────────────────────────────────────────────────────────────────
# Vide = désactivé, sans surcoût. En production, son absence rend muettes les
# alertes des crons (réconciliation, reversement au statut inconnu).
SENTRY_DSN=
# Environnement affiché dans Sentry. À défaut, NODE_ENV.
SENTRY_ENVIRONMENT=
# Fractions entre 0 et 1 — PAS des pourcentages. `10` au lieu de `0.1` tracerait
# dix fois chaque requête ; le schéma le refuse désormais. Défaut : 0.1.
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=
