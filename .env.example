# Database
DATABASE_URL=postgresql://user:password@localhost:5432/lilia_db

# Firebase Admin SDK (get these from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMS Infobip
INFOBIP_API_KEY=
INFOBIP_BASE_URL=          # ex: xxxxx.api.infobip.com (propre au compte Infobip)
INFOBIP_SENDER=LiliaFood   # sender ID alphanumerique enregistre sur le portail

# Payments
PAYMENT_MODE=MANUAL
LILIA_PAYMENT_PHONE=+242000000000

# MTN Mobile Money (required when PAYMENT_MODE=SANDBOX or MTN_PRODUCTION)
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=your-collection-subscription-key
MTN_MOMO_CALLBACK_URL=https://your-api.example.com/webhooks/mtn-momo
MTN_MOMO_WEBHOOK_SECRET=your-shared-webhook-secret
MTN_MOMO_API_KEY=your-api-key
MTN_MOMO_API_USER=your-api-user

# Resend — e-mails transactionnels (bienvenue, nouveau menu, invitation vendeur)
# Clé API : https://resend.com/api-keys
# ⚠️ RESEND_SENDER_EMAIL doit être sur un domaine VÉRIFIÉ dans Resend
#    (https://resend.com/domains). Sinon l'API répond 403 et les invitations
#    vendeur n'arrivent jamais.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_SENDER_EMAIL=noreply@liliafood.com
RESEND_SENDER_NAME=Lilia Food

# Environment
NODE_ENV=development
PORT=3000

# Redis (Tracking + Idempotency)
REDIS_URL=redis://localhost:6379
