// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // `relationMode = "prisma"` (retiré en août 2026) désactivait les clés
  // étrangères au niveau base et faisait émuler les relations par le client.
  // C'est un mode conçu pour les bases qui ne supportent pas les FK
  // (PlanetScale, Vitess) ; sur PostgreSQL c'était un renoncement pur :
  //
  //  - aucune intégrité référentielle garantie — toute écriture hors Prisma
  //    (psql, script d'admin, outil de BI, migration SQL manuelle) pouvait
  //    créer des lignes pointant vers un parent inexistant, et l'a fait :
  //    l'audit du 27/08/2026 a trouvé 24 orphelins sur 5 relations ;
  //  - les `onDelete: Cascade` n'étaient qu'émulés par le client ;
  //  - chaque relation nested générait des requêtes supplémentaires que le
  //    moteur aurait résolues nativement.
  //
  // Le défaut (`foreignKeys`) est désormais actif : les 45 contraintes sont
  // créées par la migration `20260827_enable_foreign_keys`.
}

model User {
  id            String         @id @default(cuid())
  firebaseUid   String         @unique
  email         String         @unique
  nom           String?
  phone         String?
  imageUrl      String?
  role          Role           @default(CLIENT)
  /// Disponibilité **du moment**, changée plusieurs fois par jour par le livreur
  /// lui-même. À ne pas confondre avec `DriverProfile.isActive` (le livreur
  /// est-il en service sur la plateforme ?) ni avec `statusUser` (son compte
  /// est-il valide ?). Reste sur `User` et non sur `DriverProfile` : c'est un
  /// état volatil, déjà indexé et lu à chaque assignation.
  driverStatus  DriverStatus?
  /// Profil métier du livreur. `null` pour tous les autres rôles.
  driverProfile DriverProfile?
  lastLogin     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  restaurant    Restaurant?
  deliveries    Delivery[]
  cart          Cart?
  adresses      Adresses[] // Ajout de la relation aux adresses
  fcmTokens     FcmToken[]
  reviews       Review[]
  orders        Order[] // Commandes passées par l'utilisateur
  promoUsages   PromoUsage[]   @relation("UserPromoUsages")

  // Ajout recent 04/04/2026
  statusUser StatusUser @default(ACTIVE)

  // Parrainage
  referralCode     String? @unique // code unique à partager
  referredByCode   String? // code du parrain utilisé à l'inscription
  referralRewarded Boolean @default(false) // vrai quand la récompense a été émise

  // Points de fidélité
  loyaltyPoints       Int                  @default(0)
  loyaltyTransactions LoyaltyTransaction[]
  favorites           Favorite[]

  // Flags d’idempotence bienvenue
  welcomeEmailSentAt DateTime?
  welcomeSmsSentAt   DateTime?

  // Actions d'administration réalisées PAR ce compte (journal d'audit)
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditActor")

  // Notes de livraison : reçues en tant que livreur, données en tant que client
  delivererReviews        DeliveryReview[] @relation("DelivererReviews")
  customerDeliveryReviews DeliveryReview[] @relation("CustomerDeliveryReviews")

  @@index([referredByCode]) // getReferralStats : 2 count() par ouverture de l'écran (fix M19)
}

model LoyaltyTransaction {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id])
  points    Int // positif = gain, négatif = dépense
  // Nature de l'écriture. Sert de clé de déduplication avec orderId (fix M5) :
  // deux chemins mènent à LIVRER (PATCH /orders/:id/status et
  // PATCH /deliveries/:id/status) et créditaient chacun leur copie des points.
  type      LoyaltyTransactionType @default(ADJUSTMENT)
  reason    String // ex: "Commande #ABC123", "Récompense parrainage"
  orderId   String? // lien optionnel à la commande
  createdAt DateTime               @default(now())

  @@unique([orderId, type]) // NULL != NULL en PG : ne contraint que les lignes portant un orderId
  @@index([userId])
  @@index([userId, createdAt(sort: Desc)]) // historique fidelite par user, plus recent en premier (LFD-9)
  @@index([userId, type, createdAt]) // plafond mensuel de parrainage (ReferralService)
}

enum LoyaltyTransactionType {
  ORDER_SPEND // points dépensés au checkout
  ORDER_EARN // points gagnés à la livraison
  CANCELLATION_REFUND // recrédit des points à l'annulation
  REFERRAL_REFERRER // récompense du parrain
  REFERRAL_REFERRED // bonus de bienvenue du filleul
  ADJUSTMENT // écriture manuelle / héritée
}

model FcmToken {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String

  @@index([userId])
}

/// Une adresse enregistrée par un client.
///
/// Elle porte depuis septembre 2026 sa **propre** position géographique. Sans
/// elle, la seule coordonnée disponible au moment de commander était le GPS du
/// téléphone : commander depuis son bureau pour une livraison à domicile
/// envoyait le livreur au bureau. « Où je suis » et « où on me livre » sont
/// deux informations distinctes, et seule la seconde appartient à l'adresse.
model Adresses {
  id         String    @id @default(cuid())
  rue        String
  ville      String
  etat       String? // Région/État
  country    String
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  isDefault  Boolean   @default(false)
  quartier   Quartier? @relation(fields: [quartierId], references: [id])
  quartierId String? // Référence au quartier pour le calcul des frais
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// Position posée par le client sur la carte. `null` tant qu'il ne l'a pas
  /// fait — les adresses créées avant cette évolution n'en ont pas, et on
  /// n'en invente pas : `locationPrecision` dit la vérité à leur sujet.
  latitude          Float?
  longitude         Float?
  /// Qualité de la position ci-dessus. Portée par la donnée elle-même plutôt
  /// que déduite d'un `latitude == null` : le repli sur le centroïde du
  /// quartier produit des coordonnées bien réelles mais approximatives, et
  /// rien ne les distinguerait sinon d'un point posé à la main.
  locationPrecision LocationPrecision @default(UNKNOWN)
  /// Repères pour le livreur : « portail bleu face à la pharmacie ». À
  /// Brazzaville, cette phrase vaut souvent mieux qu'un numéro de rue.
  landmark          String?
  /// Nom donné par le client : « Maison », « Bureau ».
  label             String?

  @@index([userId])
  @@index([quartierId])
  // Tableau de bord « adresses à compléter » : sans lui, la seule façon de
  // lister les adresses sans position est un scan complet de la table.
  @@index([locationPrecision])
}

/// Fiabilité d'une position de livraison.
///
/// Trois valeurs, pas plus : ce sont les trois seules situations qui appellent
/// une **conduite différente** de la part du livreur et de l'interface.
enum LocationPrecision {
  /// Point posé par le client sur la carte. Le livreur peut s'y fier.
  EXACT

  /// Centroïde du quartier, faute de mieux. Le livreur doit appeler.
  /// ⚠️ Ne jamais l'afficher comme une position exacte.
  APPROXIMATE

  /// Aucune coordonnée. On n'affiche **aucun** marqueur — un faux point est
  /// pire que pas de point du tout.
  UNKNOWN
}

model Restaurant {
  id            String  @id @default(cuid())
  nom           String
  // Présentation du commerce au client. Le modèle n'avait aucun champ libre :
  // le seul emplacement descriptif était `VendorProfile.story`, réservé de fait
  // aux vendeurs non-RESTAURANT par les formulaires d'admin.
  description   String? @db.Text
  // E-mail de contact du commerce, distinct de celui du propriétaire : le
  // compte owner sert à se connecter, cette adresse est publiable.
  email         String?
  adresse       String
  phone         String
  imageUrl      String?
  // `public_id` Cloudinary du logo. Sans lui, remplacer l'image d'un vendeur
  // laissait l'ancienne dans Cloudinary sans aucun moyen de la retrouver :
  // `VendorPhoto`, `ProductImage` et `MenuImage` le stockent tous, `Restaurant`
  // était le seul porteur d'image à ne pas le faire.
  imagePublicId String?

  //Ajout 04/04
  latitude  Float?
  longitude Float?

  // Localisation structurée (onboarding, août 2026). L'adresse restait une
  // chaîne libre : impossible de rattacher un vendeur à une zone de livraison
  // ni de le filtrer géographiquement. La ville n'est pas dupliquée ici, elle
  // vient de `Quartier.ville`.
  quartier             Quartier? @relation(fields: [quartierId], references: [id])
  quartierId           String?
  // Repères pour le livreur : « portail bleu face à la pharmacie ».
  deliveryInstructions String?

  owner       User          @relation(fields: [ownerId], references: [id])
  ownerId     String        @unique
  products    Product[]
  menuDuJour  MenuDuJour[]
  orders      Order[]
  reviews     Review[]
  favorites   Favorite[]
  categories  Category[] // Sections de menu propres à ce vendeur
  specialties Specialty[] // Spécialités du restaurant
  banners     Banner[] // Bannières du restaurant
  photos      VendorPhoto[] // Galerie photos vendeur

  // Statut d'activité (contrôlé par l'admin)
  isActive Boolean @default(true) // Restaurant actif/désactivé par l'admin

  // ─── Mise en ordre et mise en avant (septembre 2026) ───────────────────────
  //
  // ⚠️ Ni l'un ni l'autre ne décide de la VISIBILITÉ. Celle-ci reste portée par
  // `PUBLIC_VENDOR_WHERE` (onboardingStatus + adminApproved + isActive), qui
  // vit dans le `where` ; ces deux colonnes vivent dans l'`orderBy` et le
  // `select`. Deux clauses SQL différentes, qui ne peuvent structurellement pas
  // se contaminer : un vendeur DRAFT avec `displayOrder = 1` reste invisible.
  //
  /// Position voulue par l'administrateur. Plus petit = plus haut.
  ///
  /// Défaut volontairement élevé, et non `0` : avec `0`, « pas encore classé »
  /// et « tout premier » seraient la même valeur, et chaque nouveau vendeur
  /// atterrirait en tête du catalogue par accident. À 1000, il se range
  /// derrière ceux qu'on a explicitement classés, et le départage se fait par
  /// date de création comme avant.
  ///
  /// Les doublons sont autorisés : « ces deux-là en premier, l'ordre entre eux
  /// m'est égal » est une intention légitime, et un `@@unique` obligerait à
  /// réécrire toute la colonne à chaque insertion.
  displayOrder Int @default(1000)

  /// Mise en avant éditoriale, décidée par un administrateur.
  ///
  /// **Indépendante de `displayOrder`** : l'une dit « où », l'autre « avec un
  /// badge ». Un vendeur peut être mis en avant en 10e position, ou premier
  /// sans badge.
  ///
  /// Un booléen et non un enum de badges : « Nouveau » se dérive de
  /// `createdAt`, « Populaire » du nombre de commandes — les stocker en
  /// colonne créerait des données qui deviennent fausses toutes seules. Il ne
  /// reste qu'une seule décision proprement humaine, et un enum à une valeur
  /// utile est un booléen avec plus de cérémonie.
  isFeatured Boolean @default(false)

  // Avancement de la configuration — orthogonal aux trois booléens ci-dessus.
  //
  // `adminApproved` (validation marketplace), `isActive` (suspension) et
  // `isOpen` (ouvert maintenant) répondent chacun à une question différente et
  // peuvent varier indépendamment : un vendeur peut être approuvé, suspendu et
  // fermé en même temps. Il manquait la quatrième question — « sa boutique
  // est-elle configurée ? » — à laquelle aucun des trois ne répond.
  //
  // Trois valeurs suffisent : le détail de l'avancement (quelles cases sont
  // cochées) est **calculé** par VendorReadinessService à partir des données
  // elles-mêmes. Le stocker en colonne créerait une seconde vérité qui se
  // désynchroniserait au premier écrit hors service.
  onboardingStatus OnboardingStatus @default(DRAFT)
  activatedAt      DateTime?
  activatedById    String? // User.id de l'admin qui a activé (pas de FK, comme adminApprovedById)

  // Statut d'ouverture.
  //
  // Le défaut est passé de `true` à `false` (onboarding, août 2026) : le cron
  // d'ouverture ignorait les vendeurs sans horaires, si bien qu'un vendeur créé
  // et jamais configuré restait « ouvert » en permanence et acceptait des
  // commandes à 3 h du matin. Naître fermé est le défaut sûr ; le cron ouvre
  // dès qu'il y a des horaires à respecter.
  isOpen         Boolean          @default(false)
  manualOverride Boolean          @default(false) // Si true, le cron ne modifie pas isOpen
  operatingHours OperatingHours[]
  promoCodes     PromoCode[]      @relation("RestaurantPromoCodes")

  // Configuration de la livraison
  deliveryPriceMode        DeliveryPriceMode @default(FIXED)
  fixedDeliveryFee         Int               @default(1000) // Prix fixe si mode FIXED, en XAF entiers
  deliveryZones            DeliveryZone[] // Zones de livraison si mode ZONE_BASED
  estimatedDeliveryTimeMin Int               @default(15) // Temps de livraison min (minutes)
  estimatedDeliveryTimeMax Int               @default(30) // Temps de livraison max (minutes)
  minimumOrderAmount       Int               @default(0) // Montant minimum de commande, en XAF entiers

  // Modes de service acceptés. `Order.isDelivery` existait déjà, mais c'est un
  // choix du client par commande : rien n'exprimait qu'un vendeur ne livre pas,
  // ou ne fait que de la livraison. Les deux à `true` reproduisent le
  // comportement historique.
  supportsDelivery Boolean @default(true)
  supportsPickup   Boolean @default(true)

  // Commission prélevée par la plateforme sur ce vendeur, en pourcentage.
  // `null` = taux plateforme (`PlatformSettings.restaurantCommissionPercent`).
  // Réservé à l'ADMIN : un vendeur qui pourrait fixer sa propre commission
  // fixerait la marge de Lilia.
  //
  // ⚠️ À ne pas confondre avec `PlatformSettings.serviceFeePercent` : celui-ci
  // est un frais payé EN PLUS par le client, celle-là est retenue SUR le
  // vendeur. Deux flux d'argent opposés — les confondre facturerait deux fois.
  commissionPercent Float?

  // ─── Coordonnées de reversement (payout, août 2026) ────────────────────────
  //
  // Distinctes de `Restaurant.phone` (numéro de contact, affiché au client et
  // au livreur) et du téléphone du compte propriétaire. Rien ne dit que le
  // numéro sur lequel on appelle le restaurant est celui sur lequel il veut
  // être payé : c'est souvent un numéro de gérance, parfois un autre opérateur.
  // Envoyer de l'argent sur un numéro deviné n'est pas rattrapable.
  //
  // Les deux doivent être renseignés pour qu'un reversement soit possible ;
  // `RestaurantPayoutService` refuse en 409 avec un message nominatif sinon.
  payoutPhoneNumber  String? // MSISDN, chiffres uniquement, indicatif inclus (242…)
  payoutProvider     PayoutProvider? // opérateur du compte de reversement
  /// Nom du titulaire du compte mobile money, pour le contrôle humain avant
  /// envoi. Purement informatif — jamais transmis au prestataire.
  payoutAccountName  String?
  /// Vérification humaine des coordonnées par un administrateur.
  payoutVerifiedAt   DateTime?
  payoutVerifiedById String? // User.id (pas de FK, comme adminApprovedById)

  payouts RestaurantPayout[]

  // Multi-vendeurs (Sprint A — LIL-111)
  vendorType        VendorType     @default(RESTAURANT)
  // Défaut sûr (fix L10, audit du 28/08/2026) : la valeur par défaut était
  // `true` et la règle « false hors RESTAURANT » ne vivait que dans les
  // services. Toute création qui contournerait ces services (script, seed,
  // futur endpoint) publiait donc un vendeur non validé. Les trois chemins de
  // création posent explicitement `adminApproved = true` pour les restaurants.
  adminApproved     Boolean        @default(false)
  adminApprovedAt   DateTime?
  adminApprovedById String? // User.id de l'admin qui a approuvé (pas de FK)
  acceptsPreorders  Boolean        @default(false)
  preorderLeadHours Int? // délai minimum en heures (ex: 24)
  minAgeRequired    Int? // Réservé futur — désactivé côté code (LIL-112)
  maxOrdersPerDay   Int? // null = illimité
  vendorProfile     VendorProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorType, isActive, adminApproved]) // marketplace filtering
  @@index([vendorType, isOpen]) // vendeurs ouverts par type
  @@index([onboardingStatus, adminApproved, isActive]) // frontière de visibilité publique
  // Frontière de visibilité + tri : couvre la requête du catalogue public, qui
  // filtre sur les trois premières colonnes puis trie sur la quatrième.
  @@index([onboardingStatus, adminApproved, isActive, displayOrder])
  @@index([quartierId])
}

/// Avancement de la configuration d'un vendeur (onboarding, août 2026).
///
/// Volontairement court. Les états intermédiaires qu'on serait tenté d'ajouter
/// (« informations saisies », « photos ajoutées », « catalogue rempli ») sont
/// des vues sur les données, pas des états du vendeur : `VendorReadinessService`
/// les dérive, ce qui garantit qu'ils ne peuvent jamais mentir.
enum OnboardingStatus {
  DRAFT // en cours de configuration — jamais exposé au client
  READY // checklist satisfaite, en attente d'activation par un admin
  ACTIVATED // activé ; la visibilité dépend alors de adminApproved + isActive
}

// Profil enrichi pour les vendeurs non-restaurant (Sprint A — LIL-111)
model VendorProfile {
  id           String     @id @default(cuid())
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  story          String? // Récit du vendeur affiché sur sa page
  certifications String[] // ["Fait maison", "Bio", "Importé direct"]
  specialties    String[] // ["Vins de Bordeaux", "Whisky écossais"]

  licenseNumber String? // BEVERAGE_SHOP : numéro de licence alcool

  nextAvailableSlot DateTime? // HOME_COOK / BAKERY
  productionNote    String? // "Commandez 24h à l'avance"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Spécialités d'un restaurant (ex: "Pizza", "Sushi", "Burgers", "Africain")
model Specialty {
  id           String     @id @default(cuid())
  name         String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, name]) // Une spécialité unique par restaurant
  @@index([restaurantId])
}

/// Section de la carte d'un vendeur — « Plats », « Accompagnements »,
/// « Spécialités Maison ».
///
/// **Appartient à un vendeur, et à un seul.** Jusqu'au 3 septembre 2026 cette
/// table était globale (`nom @unique`, aucun `restaurantId`) tout en étant
/// **ouverte en écriture au rôle RESTAURATEUR** : n'importe quel commerçant
/// pouvait créer ou renommer une entrée du vocabulaire de toute la plateforme,
/// affichée sur l'accueil de chaque client. C'était la seule table sans
/// propriétaire, et la seule modifiable par des tiers.
///
/// La taxonomie **plateforme** n'a pas disparu pour autant : elle est portée
/// par les enums `VendorType` et `ProductType`, possédés par le code, validés
/// par une matrice, et déjà consommés par les deux clients pour la découverte.
/// Il n'y a donc pas de troisième taxonomie à inventer — seulement un
/// propriétaire à donner à celle-ci.
model Category {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String

  /// Libellé affiché, tel que saisi par le vendeur.
  nom         String
  /// Dérivé de `nom` (minuscules, sans accent ni ponctuation). C'est LUI qui
  /// porte l'unicité : « Boissons » et « boissons » désignent la même section,
  /// alors que l'ancien `nom @unique` les acceptait toutes deux — une
  /// contrainte à la fois trop rigide entre vendeurs et inopérante chez un seul.
  slug        String
  description String?
  imageUrl    String?

  /// Ordre voulu par le vendeur. Sans lui, les clients triaient
  /// alphabétiquement (mobile) ou par date de création des produits (web) :
  /// aucun commerçant ne maîtrisait l'ordre de sa propre carte.
  displayOrder Int     @default(0)
  /// Masquée au client sans être supprimée. Ses produits restent vendables et
  /// remontent dans « Autres ».
  isActive     Boolean @default(true)

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Deux vendeurs peuvent avoir « Boissons ». Un vendeur ne peut pas l'avoir
  /// deux fois.
  @@unique([restaurantId, slug])
  /// Cible de la clé étrangère **composite** portée par `Product` : c'est elle
  /// qui rend structurellement impossible qu'un produit du vendeur A référence
  /// une catégorie du vendeur B. Sans elle, l'isolation ne tiendrait qu'à un
  /// `if` dans un service — et la première écriture hors service la percerait.
  @@unique([id, restaurantId])
  @@index([restaurantId, displayOrder])
}

model MenuDuJour {
  id             String        @id @default(cuid())
  nom            String
  description    String?
  imageUrl       String?
  /// Montant en francs CFA — entier (voir `Product.prixOriginal`).
  prix           Int
  type           MenuType      @default(COMBO) // COMBO = multi-produits, PLAT_SPECIAL = plat unique
  ingredients    String? // Composition du plat special (texte libre, ex: "Riz, poulet, legumes")
  stockQuotidien Int? // Quantite disponible par jour (null = illimite)
  stockRestant   Int? // Quantite restante aujourd'hui (null = illimite)
  dateDebut      DateTime // Date et heure de début de validité du menu
  dateFin        DateTime // Date et heure de fin de validité du menu
  isActive       Boolean       @default(true) // Permet de désactiver manuellement un menu
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id])
  restaurantId   String
  products       MenuProduct[] // Relation many-to-many avec Product
  orderItems     OrderItem[]
  cartItems      CartItem[]
  images         MenuImage[] // Galerie photos menu
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([restaurantId])
  @@index([dateDebut, dateFin]) // Index pour les requêtes par date
}

// Table de liaison pour la relation many-to-many entre Menu et Product
model MenuProduct {
  id        String     @id @default(cuid())
  menu      MenuDuJour @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId    String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  ordre     Int        @default(0) // Ordre d'affichage dans le menu
  createdAt DateTime   @default(now())

  @@unique([menuId, productId]) // Un produit ne peut être ajouté qu'une seule fois dans un menu
  @@index([menuId])
  @@index([productId])
}

model Product {
  id             String           @id @default(cuid())
  nom            String
  description    String?
  imageUrl       String?
  /// Montant en francs CFA. `Int` depuis le 03/09/2026 : le XAF n'a pas de
  /// sous-unité, et les DTO imposaient déjà `@IsInt` (fix B-6) — la colonne
  /// était le dernier endroit où « 1 250,5 FCFA » restait représentable.
  prixOriginal   Int
  stockQuotidien Int? // Quantite disponible par jour (null = illimite)
  stockRestant   Int? // Quantite restante aujourd'hui (null = illimite)
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id])
  restaurantId   String
  /// Section de menu du vendeur. Optionnelle : **une catégorie ne doit jamais
  /// empêcher de créer un produit.**
  ///
  /// La relation est **composite** — elle joint sur `(categoryId, restaurantId)`
  /// — pour que PostgreSQL refuse lui-même un produit du vendeur A rattaché à
  /// une catégorie du vendeur B. `onDelete` est en `Restrict` et non `SetNull` :
  /// `restaurantId` étant obligatoire, un `SET NULL` sur les deux colonnes
  /// serait invalide. Le détachement des produits est donc fait explicitement,
  /// dans la transaction de suppression (`CategoriesService.remove`).
  category       Category?        @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  categoryId     String?
  variants       ProductVariant[]
  menus          MenuProduct[] // Relation many-to-many avec MenuDuJour
  orderItems     OrderItem[]
  cartItems      CartItem[]
  images         ProductImage[] // Galerie photos produit

  // Multi-vendeurs (Sprint A — LIL-111)
  productType ProductType @default(FOOD)
  stockMode   StockMode   @default(DAILY) // PERMANENT n'est pas reset par le cron

  // Métadonnées alcool (productType = ALCOHOL)
  alcoholContent Float? // % vol, ex: 40.0
  vintage        Int? // millésime, ex: 2019
  origin         String? // "Bordeaux, France"
  volumeMl       Int? // volume en ml, ex: 750

  // Métadonnées fait maison / pâtisserie
  ingredients   String? // liste pour info allergènes
  shelfLifeDays Int? // durée conservation en jours
  madeToOrder   Boolean @default(false)

  // Disponibilité horaire (BAKERY surtout) — appliquée au catalogue ET au
  // checkout depuis l'audit du 28/08/2026 (fix M1). Auparavant validée à
  // l'écriture puis jamais relue : une viennoiserie du matin restait
  // commandable à 3 h.
  availableFrom  String? // "HH:mm"
  availableUntil String? // "HH:mm"

  // Disponibilité et retrait du catalogue (fix M2).
  //
  // `OrderItem.productId` est en RESTRICT depuis Ar1 : `DELETE /products/:id`
  // renvoyait 409 dès la première vente, et le seul contournement
  // (`stockQuotidien = 0`) affiche « épuisé » et non « retiré ». Deux notions
  // distinctes :
  //  - `isAvailable = false` : temporairement indisponible, le vendeur le
  //    remettra ;
  //  - `deletedAt` : retiré du catalogue pour de bon, mais la ligne survit
  //    pour que l'historique des commandes reste lisible.
  isAvailable Boolean   @default(true)
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, productType]) // catalogue par type
  @@index([productType, stockMode]) // cron reset DAILY uniquement
  @@index([restaurantId, deletedAt, isAvailable]) // catalogue vendeur filtré (fix M2)
}

model ProductVariant {
  id        String     @id @default(cuid())
  label     String? // e.g., "30cl", "1.5L", "Normal", "Grand"
  /// Montant en francs CFA — entier (voir `Product.prixOriginal`).
  prix      Int
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  cartItems CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id])
  userId    String     @unique // Un utilisateur a un seul panier
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product        @relation(fields: [productId], references: [id])
  productId String
  menu      MenuDuJour?    @relation(fields: [menuId], references: [id])
  menuId    String?
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String
  quantite  Int
  createdAt DateTime       @default(now())

  // ⚠️ En PostgreSQL, `NULL != NULL` : cette contrainte ne protège PAS les
  // lignes `menuId = null`, c'est-à-dire les produits individuels — soit le cas
  // le plus fréquent (fix L9). Un index unique **partiel**
  // `WHERE "menuId" IS NULL` la complète, créé par la migration
  // `20260828200000_cart_item_partial_unique` (Prisma ne sait pas déclarer un
  // index partiel).
  @@unique([cartId, variantId, menuId]) // Permet un même variant comme produit individuel ET dans un menu
  @@index([variantId])
  @@index([productId])
  @@index([menuId])
}

// 04/04/2026 ÉTAPE 1 — Ajouter les nouveaux enums (non-breaking)

model Order {
  id                 String            @id @default(cuid())
  restaurant         Restaurant        @relation(fields: [restaurantId], references: [id])
  restaurantId       String
  user               User              @relation(fields: [userId], references: [id])
  userId             String
  /// Montants en francs CFA — **entiers** (dette M12 soldée le 03/09/2026).
  ///
  /// Le XAF n'a pas de sous-unité : « 1 250,5 FCFA » ne veut rien dire. Tous
  /// les calculs passaient déjà par `Math.round` ou `money.util.ts` ; la
  /// colonne restait le dernier endroit où une décimale était représentable —
  /// et donc où une écriture hors service pouvait en introduire une.
  subTotal           Int // Sous-total des articles
  deliveryFee        Int // Frais de livraison (0 si retrait)
  serviceFee         Int               @default(0) // frais de service payés par le client
  total              Int // subTotal + deliveryFee + serviceFee - discountAmount
  isDelivery         Boolean           @default(true) // true = livraison, false = retrait au restaurant
  deliveryAddress    String? // Adresse de livraison (null si retrait)
  // 04/04/2026
  orderHistory       OrderHistory[] // Historique des changements de statut
  // ── Destination de livraison, figée à la commande ──────────────────────
  // Snapshot délibéré : le client peut corriger son adresse le lendemain, la
  // commande d'hier doit continuer à pointer là où elle a été livrée. Même
  // raison que `OrderItem.snapshotPrice` et `Order.commissionPercent`.
  //
  // ⚠️ Depuis septembre 2026 ces coordonnées sont **résolues par le serveur**
  // à partir de `Adresses`, jamais reprises du corps de la requête : le client
  // envoyait le GPS de son téléphone, donc l'endroit où il se trouvait au
  // moment de payer et non celui où il voulait être livré.
  /// Fiabilité de la destination, figée elle aussi. Sans elle, l'app livreur
  /// ne peut pas distinguer un point posé à la main d'un centroïde de
  /// quartier — et afficherait les deux avec le même aplomb.
  deliveryPrecision  LocationPrecision @default(UNKNOWN)
  /// Repères du client, recopiés de l'adresse au moment de la commande.
  deliveryLandmark   String?
  deliveryLatitude   Float? // nouveau
  deliveryLongitude  Float? // nouveau  
  deliveryQuartierId String? // nouveau — pour les frais de zone
  deleteCommande     Boolean           @default(false)
  paymentMethod      PaymentMethod // Méthode de paiement
  status             OrderStatus       @default(EN_ATTENTE)
  paidAt             DateTime? // Date de paiement
  notes              String? // Notes optionnelles du client pour le restaurant
  contactPhone       String? // Numéro de téléphone saisi lors de la commande
  items              OrderItem[]
  reviews            Review[]
  delivery           Delivery?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  Payment        Payment[]
  promoCodeId    String?
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id])
  discountAmount Int        @default(0) // remise totale (promo + fidélité), en XAF

  // Commission plateforme figée au moment de la commande (onboarding, août
  // 2026). `Restaurant.commissionPercent` peut changer ; sans ce snapshot, un
  // changement de taux réécrirait rétroactivement ce que Lilia a prélevé sur
  // des commandes déjà encaissées — un chiffre comptable ne se recalcule pas.
  // Même raison que `OrderItem.snapshotPrice`.
  /// Taux, en pourcentage — reste `Float` : c'est une proportion, pas un
  /// montant. Un taux de 8,5 % est parfaitement légitime.
  commissionPercent Float @default(0)
  commissionAmount  Int   @default(0) // montant retenu sur subTotal, en XAF

  // Précommandes (Sprint A — LIL-111)
  isPreorder          Boolean   @default(false)
  scheduledFor        DateTime? // date/heure de livraison souhaitée
  preorderConfirmedAt DateTime? // confirmé par le vendeur

  // Vérification d'âge (alcool — Sprint A — LIL-111)
  ageVerified   Boolean   @default(false)
  ageVerifiedAt DateTime?

  // Remboursement ouvert si la commande est annulée après paiement (fix H5)
  refund Refund?

  /// Reversement au vendeur — au plus un par commande (`@@unique` côté
  /// `RestaurantPayout.orderId`). Absent tant qu'un administrateur ne l'a pas
  /// déclenché : encaisser le client et payer le vendeur sont deux décisions
  /// distinctes.
  payout RestaurantPayout?

  @@index([restaurantId, status, createdAt(sort: Desc)]) // dashboard resto: commandes par statut, plus recentes (LFD-9)
  @@index([promoCodeId])
  @@index([restaurantId])
  @@index([userId])
  @@index([status]) // ← manquait
  @@index([createdAt]) // ← manquait
  @@index([userId, createdAt(sort: Desc)]) // GET /orders/my — pagination client (fix M19)
  @@index([status, createdAt]) // cron d'expiration des commandes impayées (fix M19)
}

model OrderItem {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product     @relation(fields: [productId], references: [id])
  productId String
  menu      MenuDuJour? @relation(fields: [menuId], references: [id])
  menuId    String?
  variant   String // e.g., "1.5L"
  quantite  Int
  prix      Int // XAF entiers
  createdAt DateTime    @default(now())

  // 04/04/2026
  variantId     String? // nullable pour les commandes existantes
  variantLabel  String? // snapshot du label au moment de la commande
  snapshotPrice Int? // snapshot du prix à la commande, en XAF

  @@index([orderId])
  @@index([productId])
  @@index([menuId])
}

model OrderHistory {
  id         String      @id @default(cuid())
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  fromStatus OrderStatus
  toStatus   OrderStatus
  actionId   String // "CLIENT", "RESTAURATEUR", "LIVREUR", "SYSTEM"
  reason     String? // Raison de l'annulation ou du changement de statut
  createdAt  DateTime    @default(now())

  @@index([orderId])
}

enum DriverStatus {
  AVAILABLE
  ON_DELIVERY
  OFFLINE
}

/// Moyen de locomotion du livreur.
///
/// Ce n'est pas une information décorative : elle décide de ce qu'on peut lui
/// confier. Une moto et un vélo n'ont ni le même rayon d'action ni la même
/// capacité, et `PIETON` n'a pas de plaque à saisir — c'est ce champ qui rend
/// `plateNumber` pertinent ou non.
enum VehicleType {
  MOTO
  VELO
  VOITURE
  PIETON
}

/// Informations métier du livreur.
///
/// Séparé de `User` plutôt que fondu dedans, pour deux raisons :
///
/// 1. ces colonnes n'ont de sens que pour un livreur — les porter sur `User`
///    ferait traîner à chaque client une demi-douzaine de colonnes nulles ;
/// 2. et surtout, l'existence de la ligne **est** la règle : `role = LIVREUR`
///    sans profil n'est plus un état atteignable. Avant septembre 2026, c'était
///    l'état nominal, et rien dans le système ne savait quel véhicule conduisait
///    un livreur, ni s'il avait le droit de rouler.
///
/// ⚠️ Trois notions distinctes ne doivent jamais être confondues :
///   · `User.statusUser`         — le compte est-il valide ? (ACTIVE / BLOCKED / DELETED)
///   · `DriverProfile.isActive`  — le livreur est-il en service sur la plateforme ?
///   · `User.driverStatus`       — est-il disponible **maintenant** ?
/// Un compte ACTIVE, un profil ACTIF et une disponibilité OFFLINE est un état
/// parfaitement normal : le livreur a fini sa journée.
model DriverProfile {
  id     String @id @default(cuid())
  userId String @unique
  /// `Cascade` : le profil n'a aucune valeur comptable et aucun sens sans son
  /// compte. Il est aussi supprimé explicitement par `UserDeletionService`
  /// (plaque et permis sont des données personnelles).
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleType   VehicleType @default(MOTO)
  /// Immatriculation. Vide pour `VELO` et `PIETON` — la validation métier vit
  /// dans le DTO, pas ici : une colonne ne peut pas exprimer « requis selon la
  /// valeur d'une autre colonne ».
  plateNumber   String?
  licenseNumber String?
  licenseExpiry DateTime?

  /// Quartiers d'affectation. Vide = toute la ville, ce qui est le comportement
  /// historique et reste le défaut : restreindre par défaut rendrait
  /// inassignables tous les livreurs existants au déploiement.
  zones Quartier[] @relation("DriverZones")

  /// Le livreur est-il en service ? Décidé par un administrateur.
  /// Défaut `false` : un livreur qu'on vient de créer n'a pas encore été
  /// contrôlé. Les profils rétro-créés par la migration naissent `true`, sans
  /// quoi les livreurs en activité disparaîtraient de la file d'assignation.
  isActive      Boolean   @default(false)
  activatedAt   DateTime?
  /// `User.id` de l'admin qui a activé — pas de FK, comme `adminApprovedById`.
  activatedById String?

  /// Motif de la dernière désactivation, pour que la décision reste lisible.
  deactivationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Delivery {
  id          String         @id @default(cuid())
  order       Order          @relation(fields: [orderId], references: [id])
  orderId     String         @unique
  deliverer   User?          @relation(fields: [delivererId], references: [id])
  delivererId String?
  status      DeliveryStatus @default(EN_ATTENTE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  estimatedArrival DateTime? // ETA calculé
  // Horodatage des trois moments distincts de la course. `pickedUpAt` était
  // renseigné dès l'acceptation, ce qui en faisait une donnée fausse : il est
  // désormais écrit à la récupération réelle du repas.
  acceptedAt       DateTime? // le livreur a accepté et part au restaurant
  pickedUpAt       DateTime? // le livreur a le repas en main
  deliveredAt      DateTime? // timestamp réel de livraison

  // Position dernière connue du livreur
  lastLatitude   Float?
  lastLongitude  Float?
  lastPositionAt DateTime?
  locations      DeliveryLocation[]

  review DeliveryReview? // note laissée par le client après livraison

  @@index([delivererId, status]) // missions d'un livreur filtrees par statut (LFD-9)
  @@index([delivererId])
  @@index([status]) // ← manquait
}

/// Note du LIVREUR par le client, après livraison.
///
/// Modèle distinct de `Review` (qui note un vendeur) plutôt qu'extension de
/// celui-ci : `Review.orderId` est `@unique`, donc y loger la note du livreur
/// interdirait de noter le restaurant ET le livreur pour la même commande. Et
/// rendre `Review.restaurantId` nullable pour un modèle polymorphe fragiliserait
/// les huit requêtes qui s'appuient dessus, sans rien simplifier.
///
/// `@@unique([deliveryId])` porte nativement la règle métier « une seule note
/// par livraison » : la contrainte est en base, pas seulement dans le service.
model DeliveryReview {
  id          String   @id @default(cuid())
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  deliveryId  String   @unique
  orderId     String // dénormalisé : évite une jointure sur l'écran « mes notes »
  deliverer   User     @relation("DelivererReviews", fields: [delivererId], references: [id], onDelete: Restrict)
  delivererId String
  user        User     @relation("CustomerDeliveryReviews", fields: [userId], references: [id], onDelete: Restrict)
  userId      String
  rating      Int // 1 à 5, borné par le DTO
  comment     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([delivererId, createdAt(sort: Desc)]) // historique + moyenne du livreur
  @@index([delivererId, rating]) // agrégats (groupBy) sans charger les lignes
  @@index([userId])
}

// Nouvelle table — n'affecte pas l'existant
model DeliveryLocation {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float? // précision GPS en mètres
  recordedAt DateTime @default(now())

  @@index([deliveryId, recordedAt])
}

enum Role {
  ADMIN
  RESTAURATEUR
  LIVREUR
  CLIENT
}

enum StatusUser {
  INACTIVE
  ACTIVE
  BLOCKED
  // Compte supprimé par son propriétaire (DELETE /users/me). La ligne User est
  // conservée anonymisée : Order/Payment sont des pièces comptables qu'on ne
  // peut pas effacer, et elles portent une FK vers User depuis Ar1.
  DELETED
}

/// Opérateur choisi par le CLIENT pour payer.
enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY
}

/// Opérateur du compte sur lequel un VENDEUR est reversé.
///
/// Enum distinct de `PaymentMethod` bien que les valeurs se ressemblent : les
/// deux répondent à des questions différentes et n'évolueront pas ensemble (un
/// reversement pourra un jour se faire par virement bancaire, ce qui n'a aucun
/// sens comme moyen de paiement client au Congo). Les fondre créerait un
/// couplage entre l'encaissement et le reversement — exactement ce que ce
/// chantier sépare.
enum PayoutProvider {
  MTN_MOMO
  AIRTEL_MONEY
}

enum OrderStatus {
  EN_ATTENTE
  PAYER
  EN_PREPARATION
  PRET
  EN_ROUTE
  LIVRER
  ANNULER
}

enum DeliveryStatus {
  EN_ATTENTE // livraison créée, aucun livreur
  ASSIGNER // un livreur est désigné, il n'a pas encore répondu
  // Le livreur a accepté et se rend au restaurant. Il n'a PAS le repas.
  //
  // Cet état manquait : `acceptDelivery` faisait passer la livraison
  // directement en EN_TRANSIT, écrivait `pickedUpAt` et basculait la commande
  // en EN_ROUTE — le client recevait « votre livreur est en chemin » alors que
  // le livreur n'avait encore rien récupéré. Accepter une mission n'est pas
  // être en route vers le client.
  ACCEPTER
  EN_TRANSIT // repas récupéré, le livreur roule vers le client
  LIVRER
  ECHEC
}

/// Encaissement auprès du CLIENT (collection). À ne pas confondre avec
/// `RestaurantPayout`, qui est le reversement au vendeur : deux mouvements
/// d'argent opposés, à deux moments différents, avec chacun son identifiant
/// chez le prestataire (`depositId` ici, `payoutId` là-bas).
model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  amount                Int // XAF entiers
  currency              String        @default("XAF")
  phoneNumber           String
  status                PaymentStatus @default(PENDING)
  provider              String        @default("MTN_MOMO")
  /// `depositId` pawaPay / `X-Reference-Id` MTN. Généré par NOUS avant l'appel
  /// au prestataire : c'est la clé d'idempotence côté PSP (un rejeu du même
  /// identifiant renvoie `DUPLICATE_IGNORED`, jamais un second débit).
  providerTransactionId String?
  metadata              Json          @default("{}")

  /// Opérateur visé, snapshot du choix fait à cette tentative. `Order.paymentMethod`
  /// porte l'intention initiale ; une seconde tentative peut viser un autre
  /// opérateur (plus de solde MTN, le client paie en Airtel).
  method PaymentMethod?

  /// Code d'échec du prestataire, tel quel. En colonne et non dans `metadata` :
  /// c'est ce qu'on filtre dans la file d'administration (« combien de PIN
  /// refusés cette semaine ? ») et un `Json` ne s'indexe pas.
  failureCode    String?
  failureMessage String?

  /// Instant de résolution. `updatedAt` servait de proxy pour le KPI « délai de
  /// validation » (`admin-payments.service.ts`) — il ment dès qu'une autre
  /// écriture touche la ligne.
  completedAt DateTime?

  /// Frais facturés par le prestataire sur cet encaissement, en XAF.
  /// **Charge de Lilia Food** : jamais déduit de ce que touche le vendeur.
  /// `null` tant que le prestataire ne l'a pas communiqué.
  ///
  /// ⚠️ `Int` : les prestataires annoncent leurs frais en décimal (« 12.50 »).
  /// L'arrondi doit se faire **à l'ingestion**, via `toXaf()`. La colonne le
  /// rend obligatoire au lieu de le laisser à la vigilance de l'appelant.
  collectionFeeXaf Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order          @relation(fields: [orderId], references: [id])
  refunds Refund[]
  events  PaymentEvent[]

  @@index([orderId])
  @@index([status]) // dashboard paiements filtrés par statut
  @@index([orderId, status]) // assertNoPendingPayment + cron d'expiration (fix M19)
  // Deux index UNIQUES PARTIELS complètent ceux-ci ; Prisma ne sait pas les
  // déclarer, ils sont créés en SQL par la migration `payment_unique_indexes` :
  //   · payments_order_pending_uq  ON (orderId) WHERE status = 'PENDING'
  //   · payments_provider_tx_uq    ON (provider, providerTransactionId)
  //                                WHERE providerTransactionId IS NOT NULL
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

/// Reversement au VENDEUR (payout), déclenché **manuellement par un
/// administrateur** quand la commande est prête.
///
/// Volontairement une entité distincte de `Payment` plutôt qu'un type de plus
/// sur celui-ci : les deux n'ont ni le même sens du flux d'argent, ni les mêmes
/// champs (un payout porte une commission figée et un bénéficiaire vendeur), ni
/// le même cycle de vie, ni le même identifiant chez le prestataire. Les fondre
/// obligerait chaque requête à filtrer sur un discriminant, et la première
/// requête qui l'oublierait mélangerait des encaissements et des reversements
/// dans un même total.
///
/// `@@unique([orderId])` porte **en base** la règle « un vendeur n'est payé
/// qu'une fois par commande » : c'est elle qui rend deux administrateurs
/// cliquant simultanément incapables de créer deux reversements. Une ligne
/// `FAILED` est supprimée avant de réessayer (cf. RestaurantPayoutService), ce
/// qui garde la contrainte intacte tout en autorisant une nouvelle tentative.
model RestaurantPayout {
  id           String     @id @default(cuid())
  orderId      String     @unique
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  // ─── Snapshot financier, figé à la création ────────────────────────────────
  // Ces cinq valeurs ne sont JAMAIS recalculées. Si le taux de commission passe
  // de 10 % à 12 % demain, un reversement d'hier doit continuer à dire 10 % —
  // c'est une pièce comptable, au même titre que `OrderItem.snapshotPrice`.
  /// Montant des produits revenant au vendeur (= `Order.subTotal`).
  /// Ni les frais de service client, ni la livraison n'y entrent.
  grossAmount       Int
  /// Proportion, pas un montant : reste `Float`.
  commissionPercent Float
  commissionAmount  Int
  /// `grossAmount - commissionAmount` — c'est CE montant qui part au prestataire.
  amount            Int
  currency          String @default("XAF")

  // ─── Destinataire, également figé ──────────────────────────────────────────
  // Le numéro peut changer dans la fiche du vendeur ; ce reversement-ci est
  // parti vers celui-ci.
  phoneNumber  String
  /// Opérateur du compte crédité, snapshot de `Restaurant.payoutProvider` au
  /// moment de l'envoi (`MTN_MOMO` / `AIRTEL_MONEY`). Le code technique attendu
  /// par le prestataire (`MTN_MOMO_COG`…) en est dérivé à l'appel : il dépend de
  /// la configuration du compte marchand et n'a pas à être figé ici.
  providerCode String

  status                PayoutStatus @default(PENDING)
  provider              String       @default("PAWAPAY")
  /// `payoutId` pawaPay — généré par nous, distinct du `depositId` de l'encaissement.
  providerPayoutId      String?
  /// Identifiant de la transaction chez l'opérateur, renvoyé par le prestataire.
  providerTransactionId String?

  failureCode    String?
  failureMessage String?

  /// Frais facturés par le prestataire sur ce reversement, en XAF.
  /// **Charge de Lilia Food** : jamais déduit du montant reversé au vendeur.
  /// `Int` pour la même raison que `Payment.collectionFeeXaf` : arrondir à
  /// l'ingestion, jamais au moment de lire.
  payoutFeeXaf Int?

  /// `User.id` de l'administrateur qui a déclenché le reversement.
  requestedBy String
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  metadata Json           @default("{}")
  events   PaymentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, status])
  @@index([status, requestedAt])
  @@index([restaurantId, completedAt])
  @@map("restaurant_payouts")
}

/// Cycle de vie d'un reversement.
///
/// `PENDING → SUCCESS | FAILED | CANCELLED`, et les états terminaux le sont
/// vraiment : un reversement réussi ne redevient jamais en attente. La règle
/// est portée par `PAYOUT_TRANSITIONS` (payout-state.machine.ts) et par les
/// `updateMany` conditionnés sur `PENDING`.
enum PayoutStatus {
  PENDING // envoyé au prestataire, en attente de confirmation
  SUCCESS // argent reçu par le vendeur — SEUL état où le vendeur est « payé »
  FAILED // refusé par le prestataire ou l'opérateur ; nouvelle tentative possible
  CANCELLED // abandonné avant aboutissement (arbitrage administratif)
}

/// Journal des signaux reçus d'un prestataire de paiement — callbacks et
/// réponses de réconciliation, pour les encaissements **et** les reversements.
///
/// Trois choses qu'aucune autre table ne donne :
///  · la preuve, en cas de litige, de ce que le prestataire a envoyé et quand —
///    `metadata` est écrasé à chaque écriture ;
///  · la détection des callbacks **hors ordre** (un `FAILED` qui arrive après un
///    `COMPLETED` sur la même transaction) ;
///  · le rejeu d'un callback perdu sans avoir à le redemander au prestataire.
///
/// En écriture seule : aucun endpoint ne la modifie ni ne la supprime.
model PaymentEvent {
  id String @id @default(cuid())

  /// L'un des deux est renseigné — jamais les deux. Tous deux nuls quand le
  /// callback ne correspond à aucune transaction connue (on garde quand même
  /// la trace : c'est le signal d'une fuite de configuration ou d'une attaque).
  paymentId String?
  payment   Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  payoutId  String?
  payout    RestaurantPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  kind       PaymentEventKind
  provider   String // 'PAWAPAY', 'MTN_MOMO', 'MANUAL'
  externalId String // depositId ou payoutId
  source     PaymentEventSource
  /// Statut brut annoncé par le prestataire ('COMPLETED', 'FAILED', 'ACCEPTED'…),
  /// conservé sans traduction : c'est ce qu'il a dit, pas ce qu'on en a compris.
  rawStatus  String
  /// Corps complet du signal. **Sans les en-têtes d'authentification.**
  payload    Json
  outcome    PaymentEventOutcome @default(APPLIED)
  receivedAt DateTime            @default(now())

  @@index([provider, externalId])
  @@index([paymentId, receivedAt])
  @@index([payoutId, receivedAt])
  @@index([outcome, receivedAt]) // supervision : compter doublons et incohérences
}

enum PaymentEventKind {
  COLLECTION
  PAYOUT
}

enum PaymentEventSource {
  WEBHOOK // callback du prestataire
  RECONCILIATION // interrogation par le cron
  CLIENT_POLL // déclenché par GET /payments/:id/status
  INITIATION // réponse synchrone à la demande d'opération
}

enum PaymentEventOutcome {
  APPLIED // a fait avancer la transaction
  DUPLICATE // état déjà atteint — rejeu sans effet
  IGNORED // transaction inconnue, ou statut non terminal
  MISMATCH // montant/devise incohérents ⇒ aucune transition, incident ouvert
}

enum DayOfWeek {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

