enum DiscountType {
  FIXED // montant fixe : -500 FCFA
  PERCENT // pourcentage : -10%
  FREE_DELIVERY // livraison gratuite
}

model PromoCode {
  id          String  @id @default(cuid())
  code        String  @unique // "BIENVENUE500" — toujours uppercase
  description String? // affiché dans l'app : "500 FCFA offerts sur ta 1ère commande"

  discountType  DiscountType
  /// ⚠️ **Volontairement `Float`, contrairement à tous les autres montants.**
  ///
  /// Cette colonne porte deux choses selon `discountType` : un montant XAF si
  /// `FIXED` (500), un **pourcentage** si `PERCENT` (10, ou 7,5). La passer en
  /// `Int` interdirait silencieusement une campagne à 7,5 % — une capacité
  /// commerciale réelle, supprimée au nom d'une règle qui ne vaut que pour la
  /// moitié des lignes.
  ///
  /// L'intégrité du cas `FIXED` est tenue par le DTO (`@ValidateIf` + `@IsInt`),
  /// là où le discriminant est connu.
  discountValue Float
  maxDiscount   Int? // plafond si PERCENT, en XAF

  minOrderAmount  Int  @default(0) // montant minimum pour activer le code, en XAF
  maxUsageTotal   Int? // null = illimité — ex: 100 pour une campagne limitée
  maxUsagePerUser Int  @default(1) // 1 = 1 fois par utilisateur

  firstOrderOnly Boolean @default(false) // réservé aux nouveaux clients
  isActive       Boolean @default(true)

  // Restriction par restaurant (null = toute la plateforme)
  restaurantId   String?
  restaurant     Restaurant? @relation("RestaurantPromoCodes", fields: [restaurantId], references: [id])
  // `discountAmount` a été SUPPRIMÉ de ce modèle (03/09/2026). Dupliqué depuis
  // `Order.discountAmount`, il n'était NI lu NI écrit depuis sa création :
  // toutes les lignes portaient le défaut `0`. Une colonne qui ressemble à un
  // montant sans en être un finit par être lue de bonne foi — c'est un piège,
  // pas une donnée.
  startsAt       DateTime    @default(now())
  expiresAt      DateTime? // null = pas d'expiration

  usages    PromoUsage[]
  orders    Order[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([code])
  @@index([isActive, startsAt, expiresAt])
  @@index([restaurantId])
}

model PromoUsage {
  id              String    @id @default(cuid())
  promoCode       PromoCode @relation(fields: [promoCodeId], references: [id])
  promoCodeId     String
  userId          String
  user            User      @relation("UserPromoUsages", fields: [userId], references: [id])
  orderId         String    @unique // 1 promo max par commande
  discountApplied Int // montant réellement déduit (snapshot), en XAF
  usedAt          DateTime  @default(now())

  @@index([promoCodeId])
  @@index([userId])
}

model Favorite {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@index([userId])
}

// ============================================================
// Incidents — tracker opérationnel (annulations, retards, plaintes...)
// ============================================================

enum IncidentType {
  ORDER_CANCELLED // commande annulée
  ORDER_DELAYED // retard de livraison
  PAYMENT_FAILED // échec paiement
  DRIVER_NO_SHOW // livreur ne s'est pas présenté
  DRIVER_ACCIDENT // accident livreur
  CUSTOMER_COMPLAINT // plainte client
  RESTAURANT_CLOSED // restaurant fermé hors horaires
  STOCK_ISSUE // problème stock / produit indisponible
  WRONG_DELIVERY // mauvaise livraison
  REFUND_REQUEST // demande remboursement
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Boîte d'envoi transactionnelle (fix H7 — audit du 28/08/2026).
///
/// Le seul signal qui prévenait un vendeur qu'une commande était arrivée était
/// un push FCM émis via `EventEmitter2` **en mémoire**, après le commit :
///  - process tué entre les deux ⇒ événement perdu, définitivement, sans trace ;
///  - `@nestjs/event-emitter` applique `suppressErrors ?? true` ⇒ une erreur de
///    listener est loguée puis avalée ;
///  - vendeur sans token FCM ⇒ un simple `logger.warn` (cas déjà observé en
///    production sur les comptes ADMIN).
///
/// Une commande payée pouvait donc n'être jamais vue. La ligne est désormais
/// écrite **dans la transaction de checkout** : si la commande existe,
/// l'obligation de notifier existe aussi. Un worker la dépile avec backoff, et
/// escalade en SMS quand le push ne suffit pas.
model OutboxEvent {
  id            String            @id @default(cuid())
  type          String // 'order.created', …
  aggregateId   String // orderId, en général
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now())
  lastError     String?           @db.Text
  escalatedAt   DateTime? // date d'envoi du SMS de secours
  processedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateId, type])
}

enum OutboxEventStatus {
  PENDING // à traiter (ou à re-traiter)
  SENT // acquitté
  FAILED // abandonné après épuisement des tentatives
}

/// Remboursement d'une commande payée puis annulée (fix H5 — audit 28/08/2026).
///
/// Avant : le système restituait stock, points et code promo, mais la ligne
/// `Payment` restait `SUCCESS`, aucune entité ne matérialisait la dette envers
/// le client, aucune tâche admin n'était créée, et le `refundAmount` calculé
/// (`total >= 1000 ? total : 0`) n'alimentait qu'un message de notification —
/// une règle « non remboursable sous 1 000 XAF » qui n'apparaissait ni dans les
/// CGU ni dans l'app. Chaque annulation après paiement était donc un litige
/// non traçable.
model Refund {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId   String?
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount      Int // montant dû au client, en XAF
  status      RefundStatus @default(PENDING)
  reason      String       @db.Text
  requestedBy String? // User.id à l'origine de l'annulation
  processedBy String? // User.id de l'admin qui a exécuté le virement
  processedAt DateTime?
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orderId]) // une commande = au plus un remboursement en cours
  @@index([status, createdAt])
}

enum RefundStatus {
  PENDING // à traiter par l'admin
  PROCESSING // virement en cours
  COMPLETED // client remboursé
  REJECTED // refus motivé (fraude, commande déjà consommée…)
}

/// Journal d'audit des actions d'administration (audit du 28/08/2026).
///
/// `updateUserRole`, `banUser`, `suspendVendor` et `confirmManualPayment`
/// modifient des droits ou de l'argent et ne laissaient qu'une ligne de log
/// applicatif — perdue à la rotation, non interrogeable, non opposable. Cette
/// table est en écriture seule côté application : aucun endpoint ne la modifie
/// ni ne la supprime.
model AdminAuditLog {
  id         String           @id @default(cuid())
  actorId    String // User.id de l'administrateur qui agit
  actor      User             @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     AdminAuditAction
  targetType String // "User", "Restaurant", "Payment", "Order"…
  targetId   String
  reason     String?          @db.Text
  metadata   Json? // avant/après, montants, références
  createdAt  DateTime         @default(now())

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([action, createdAt(sort: Desc)])
}

enum AdminAuditAction {
  // Reversement vendeur déclenché à la main (août 2026). Chaque envoi d'argent
  // à un tiers doit laisser une trace nominative opposable, au même titre que
  // PAYMENT_CONFIRMED.
  PAYOUT_REQUESTED
  PAYOUT_RETRIED
  PAYOUT_CANCELLED
  VENDOR_PAYOUT_ACCOUNT_UPDATED
  USER_ROLE_CHANGED
  USER_BANNED
  USER_UNBANNED
  // Cycle de vie d'un compte livreur (septembre 2026). Créer un livreur, c'est
  // donner à quelqu'un l'accès aux adresses et aux téléphones des clients :
  // au même titre qu'un changement de rôle, la décision doit rester nominative.
  DRIVER_CREATED
  DRIVER_UPDATED
  DRIVER_ACTIVATED
  DRIVER_DEACTIVATED
  // Mise en ordre et mise en avant du catalogue — décisions éditoriales qui
  // changent ce que voit chaque client sur la page d'accueil.
  VENDOR_DISPLAY_ORDER_CHANGED
  VENDOR_FEATURED_TOGGLED
  VENDOR_CREATED
  VENDOR_ACTIVATED
  VENDOR_COMMISSION_CHANGED
  // Écriture au catalogue d'un vendeur par un administrateur : l'admin peut
  // désormais créer produits et menus au nom d'un vendeur (sans quoi il ne
  // pouvait pas amorcer une boutique), ce qui doit rester traçable.
  VENDOR_CATALOG_EDITED
  VENDOR_APPROVED
  VENDOR_SUSPENDED
  VENDOR_ACTIVE_TOGGLED
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
  REFUND_CREATED
  REFUND_UPDATED
  ORDER_STATUS_FORCED
}

model Incident {
  id           String           @id @default(cuid())
  type         IncidentType
  severity     IncidentSeverity @default(MEDIUM)
  status       IncidentStatus   @default(OPEN)
  title        String
  description  String           @db.Text
  resolution   String?          @db.Text
  // Liens optionnels — pas de FK car relationMode = prisma
  orderId      String?
  riderId      String? // User.id avec role LIVREUR
  restaurantId String?
  reportedBy   String? // User.id de qui a remonté (admin/system)
  resolvedBy   String? // User.id qui a résolu
  metadata     Json? // contexte additionnel (montants, refs paiement, etc.)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  resolvedAt   DateTime?

  @@index([status, severity])
  @@index([type, createdAt])
  @@index([orderId])
  @@index([riderId])
  @@index([restaurantId])
}

model PlatformSettings {
  id String @id @default("singleton")

  /// FRAIS DE SERVICE CLIENT — payés **en plus** par le client, ajoutés au
  /// panier (`total = subTotal + deliveryFee + serviceFee - discount`).
  /// Couvrent le fonctionnement, la technique, les frais de paiement et le
  /// support de Lilia Food.
  serviceFeePercent Float @default(8)

  /// COMMISSION VENDEUR par défaut — retenue **sur** le vendeur au moment du
  /// reversement, jamais payée par le client.
  /// `Restaurant.commissionPercent` la surcharge par vendeur quand il est non
  /// nul (Restaurant A à 10 %, B à 8 %, C à 12 %).
  ///
  /// ⚠️ Ne jamais écrire ce taux en dur dans le code : il n'est pas arrêté, et
  /// il est appelé à varier par vendeur. Le calcul passe TOUJOURS par
  /// `RestaurantPayoutService.resolveCommissionPercent`.
  restaurantCommissionPercent Float @default(10)

  loyaltyPointsPer100Xaf Int @default(1)
  loyaltyPointValueXaf   Int @default(5)
  loyaltyMinRedemption   Int @default(100)

  referrerBonusPoints Int @default(500)
  referredBonusPoints Int @default(200)

  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?

  updatedAt DateTime @updatedAt
}
