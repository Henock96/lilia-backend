// Liste des quartiers de Brazzaville
model Quartier {
  id          String          @id @default(cuid())
  nom         String          @unique // Ex: "Bacongo", "Poto-Poto", "Talangaï"
  ville       String          @default("Brazzaville")
  zones       QuartierZone[]
  adresses    Adresses[]
  restaurants Restaurant[] // Vendeurs implantés dans ce quartier
  /// Livreurs affectés à ce quartier (many-to-many implicite).
  drivers     DriverProfile[] @relation("DriverZones")
  createdAt   DateTime        @default(now())

  /// Centroïde du quartier — repli quand une adresse n'a pas de position.
  ///
  /// `null` est un état **normal et assumé** : le géocodage de Google ne
  /// reconnaît pas tous les quartiers de Brazzaville (7 des 26 renvoient le
  /// centre-ville générique, ce qui les rendrait tous identiques). Plutôt que
  /// de semer un point faux, on laisse vide et un administrateur complète via
  /// `PATCH /quartiers/:id/centroid`. Un centroïde absent dégrade proprement
  /// en `LocationPrecision.UNKNOWN`.
  latitude  Float?
  longitude Float?
}

