// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // `relationMode = "prisma"` (retiré en août 2026) désactivait les clés
  // étrangères au niveau base et faisait émuler les relations par le client.
  // C'est un mode conçu pour les bases qui ne supportent pas les FK
  // (PlanetScale, Vitess) ; sur PostgreSQL c'était un renoncement pur :
  //
  //  - aucune intégrité référentielle garantie — toute écriture hors Prisma
  //    (psql, script d'admin, outil de BI, migration SQL manuelle) pouvait
  //    créer des lignes pointant vers un parent inexistant, et l'a fait :
  //    l'audit du 27/08/2026 a trouvé 24 orphelins sur 5 relations ;
  //  - les `onDelete: Cascade` n'étaient qu'émulés par le client ;
  //  - chaque relation nested générait des requêtes supplémentaires que le
  //    moteur aurait résolues nativement.
  //
  // Le défaut (`foreignKeys`) est désormais actif : les 45 contraintes sont
  // créées par la migration `20260827_enable_foreign_keys`.
}

model User {
  id                String             @id @default(cuid())
  firebaseUid       String             @unique
  email             String             @unique
  nom               String?
  /// ⚠️ **TOUJOURS NON UNIQUE.** Dette ouverte, mesurée, et documentée ici.
  ///
  /// La réutilisation d'un numéro est le meilleur signal d'une ferme à comptes,
  /// et l'unicité SQL serait la garde idéale. Deux obstacles, dans cet ordre :
  ///
  /// 1. **`''` au lieu de `NULL`.** Les comptes historiques portaient la chaîne
  ///    vide, qui ne bénéficie **pas** de l'échappatoire que PostgreSQL accorde
  ///    à `NULL` : deux comptes sans téléphone comptaient comme un doublon.
  ///    Réglé — le code écrit `NULL`, et la migration
  ///    `20260921130000_user_phone_unique` normalise l'existant.
  ///
  /// 2. **De vrais doublons.** Mesuré en production le 21/09/2026 : trois
  ///    numéros portés par dix comptes. Deux de ces groupes contiennent des
  ///    comptes **avec des commandes** — donc ni supprimables (ce sont des
  ///    pièces comptables) ni fusionnables sans arbitrage humain.
  ///
  /// Une première version de cette migration créait l'index derrière un garde
  /// qui levait sur doublon. Il a fonctionné : la migration s'est interrompue en
  /// production, et a bloqué les déploiements. Livrer une migration dont on sait
  /// qu'elle échouera n'est pas une stratégie — la création d'index en a donc
  /// été retirée.
  ///
  /// **Pour solder la dette** : `node scripts/db/audit-phone-duplicates.js`
  /// donne la liste nominative ; arbitrer chaque groupe (garder un compte,
  /// anonymiser les autres via `UserDeletionService`) ; puis poser l'index dans
  /// une migration dédiée — en PARTIEL (`WHERE phone IS NOT NULL`), Prisma ne
  /// sachant pas le déclarer, comme `payments_order_pending_uq` et `CartItem`.
  ///
  /// En attendant, l'abus est fermé par le signal `PHONE_REUSED` du scoring de
  /// parrainage : il envoie la récompense en revue humaine au lieu de refuser
  /// une inscription potentiellement légitime. Il couvre d'ailleurs ce que
  /// l'unicité ne verrait pas — un numéro reformaté (`06…` contre `+24206…`),
  /// que l'index laisse passer et que la normalisation du script attrape.
  phone             String?
  imageUrl          String?
  role              Role               @default(CLIENT)
  /// Disponibilité **du moment**, changée plusieurs fois par jour par le livreur
  /// lui-même. À ne pas confondre avec `DriverProfile.isActive` (le livreur
  /// est-il en service sur la plateforme ?) ni avec `statusUser` (son compte
  /// est-il valide ?). Reste sur `User` et non sur `DriverProfile` : c'est un
  /// état volatil, déjà indexé et lu à chaque assignation.
  driverStatus      DriverStatus?
  /// Profil métier du livreur. `null` pour tous les autres rôles.
  driverProfile     DriverProfile?
  lastLogin         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  restaurant        Restaurant?
  deliveries        Delivery[]
  /// Toutes les fois où une course lui a été confiée — y compris celles qu'il
  /// n'a pas terminées. `deliveries` ne porte que la main COURANTE.
  deliveryAssignments DeliveryAssignment[] @relation("DelivererAssignments")
  /// Règlements de ce que Lilia Food lui doit, s'il est livreur.
  driverSettlements DriverSettlement[] @relation("DriverSettlements")
  cart              Cart?
  adresses          Adresses[] // Ajout de la relation aux adresses
  fcmTokens         FcmToken[]
  reviews           Review[]
  orders            Order[] // Commandes passées par l'utilisateur
  promoUsages       PromoUsage[]       @relation("UserPromoUsages")
  /// F3-06 — avoirs personnels (codes promo nominatifs).
  assignedPromoCodes PromoCode[]       @relation("AssignedPromoCodes")
  /// F3-06 — messages écrits dans les fils de réclamation.
  incidentMessages  IncidentMessage[]

  // Ajout recent 04/04/2026
  statusUser StatusUser @default(ACTIVE)

  // Parrainage
  referralCode          String?   @unique // code unique à partager
  referredByCode        String? // code du parrain utilisé à l'inscription
  /// Vrai quand une récompense a été **arbitrée** pour ce filleul, quelle qu'ait
  /// été la décision. La preuve opposable vit dans `ReferralReward` (statut,
  /// score, signaux, commande) ; ce booléen reste le verrou de chemin rapide et
  /// la compatibilité avec l'existant.
  referralRewarded      Boolean   @default(false)
  /// Date de l'arbitrage et commande qui l'a déclenché. Sans eux, « ce filleul
  /// a-t-il déjà généré sa récompense ? » se répondait, mais « quand » et
  /// « pourquoi » restaient introuvables (audit du 06/09/2026, D10).
  referralRewardedAt    DateTime?
  referralRewardOrderId String?

  /// Récompenses de parrainage — reçues en tant que parrain, générée en tant que
  /// filleul (au plus une, garantie par `ReferralReward.referredUserId @unique`).
  referralRewardsGiven    ReferralReward[] @relation("ReferralRewardReferrer")
  referralRewardReceived  ReferralReward?  @relation("ReferralRewardReferred")
  referralRewardsReviewed ReferralReward[] @relation("ReferralRewardReviewer")

  /// Installations applicatives depuis lesquelles ce compte s'est synchronisé.
  deviceInstallations DeviceInstallation[]

  /// Écritures de fidélité passées **par** ce compte en tant qu'administrateur.
  loyaltyAdjustmentsMade    LoyaltyTransaction[] @relation("LoyaltyAdjustmentActor")
  /// Écritures de fidélité **causées** par ce compte (filleul à l'origine d'une
  /// récompense de parrainage versée à quelqu'un d'autre).
  loyaltyTransactionsCaused LoyaltyTransaction[] @relation("LoyaltyTransactionSource")

  // Points de fidélité
  loyaltyPoints       Int                  @default(0)
  loyaltyTransactions LoyaltyTransaction[]
  favorites           Favorite[]

  // Flags d’idempotence bienvenue
  welcomeEmailSentAt DateTime?
  welcomeSmsSentAt   DateTime?

  // Actions d'administration réalisées PAR ce compte (journal d'audit)
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditActor")

  // Notes de livraison : reçues en tant que livreur, données en tant que client
  delivererReviews        DeliveryReview[] @relation("DelivererReviews")
  customerDeliveryReviews DeliveryReview[] @relation("CustomerDeliveryReviews")

  @@index([referredByCode]) // getReferralStats : 2 count() par ouverture de l'écran (fix M19)
  /// Réutilisation d'un numéro de téléphone = signal anti-abus le plus fort du
  /// parrainage (`ReferralRiskService`). Index simple et **non unique** : voir
  /// la note d'unicité sur le champ `phone` ci-dessous.
  @@index([phone])
}

model LoyaltyTransaction {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id])
  points    Int // positif = gain, négatif = dépense
  // Nature de l'écriture. Sert de clé de déduplication avec orderId (fix M5) :
  // deux chemins mènent à LIVRER (PATCH /orders/:id/status et
  // PATCH /deliveries/:id/status) et créditaient chacun leur copie des points.
  type      LoyaltyTransactionType @default(ADJUSTMENT)
  reason    String // ex: "Commande #ABC123", "Récompense parrainage"
  orderId   String? // lien optionnel à la commande
  createdAt DateTime               @default(now())

  /// Compte **à l'origine** de l'écriture, quand ce n'est pas son bénéficiaire :
  /// le filleul dont la première commande a payé le point du parrain.
  ///
  /// Sans lui, « quel filleul a généré ce point ? » n'avait pour seule réponse
  /// qu'une chaîne libre (`reason: 'Récompense parrainage — filleul activé'`) —
  /// inexploitable en litige comme en supervision (audit du 06/09/2026, D10).
  sourceUserId String?
  sourceUser   User?   @relation("LoyaltyTransactionSource", fields: [sourceUserId], references: [id], onDelete: SetNull)

  /// Administrateur auteur d'une écriture manuelle (`ADJUSTMENT`). `null` pour
  /// tout mouvement produit par le système. Aucun solde ne doit pouvoir bouger
  /// à la main sans nom.
  actorId String?
  actor   User?   @relation("LoyaltyAdjustmentActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// Contexte machine de l'écriture — porte notamment le marqueur d'idempotence
  /// des migrations de barème (`{ migration: 'loyalty-redenomination-v1' }`).
  metadata Json?

  @@unique([orderId, type]) // NULL != NULL en PG : ne contraint que les lignes portant un orderId
  @@index([userId])
  @@index([userId, createdAt(sort: Desc)]) // historique fidelite par user, plus recent en premier (LFD-9)
  @@index([userId, type, createdAt]) // plafond mensuel de parrainage (ReferralService)
  @@index([sourceUserId])
  @@index([actorId])
}

/// Arbitrage d'une récompense de parrainage — **une ligne par filleul, à vie**.
///
/// Ce modèle existe parce que trois questions restaient sans réponse fiable
/// (audit du 06/09/2026) : quelle commande a validé le parrainage, quel filleul
/// a payé le point du parrain, et pourquoi une récompense n'a pas été versée.
///
/// Il porte aussi l'idempotence **en base** : `referredUserId @unique` rend
/// structurellement impossible qu'un même filleul récompense deux fois, y
/// compris si les deux chemins vers `LIVRER` sont joués en concurrence. C'est
/// la base qui arbitre, pas un `if` — même principe que
/// `payments(orderId) WHERE status='PENDING'`.
model ReferralReward {
  id String @id @default(cuid())

  /// Bénéficiaire du point.
  referrerId String
  referrer   User   @relation("ReferralRewardReferrer", fields: [referrerId], references: [id], onDelete: Restrict)

  /// Filleul dont la première commande livrée a déclenché l'arbitrage.
  /// `@unique` : la garantie « exactement une récompense par filleul ».
  referredUserId String @unique
  referredUser   User   @relation("ReferralRewardReferred", fields: [referredUserId], references: [id], onDelete: Restrict)

  /// Commande qualifiante — la première du filleul à atteindre `LIVRER`.
  /// `@unique` aussi : une commande ne peut valider qu'un seul parrainage.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  status ReferralRewardStatus

  /// Score de risque 0–100 et détail des signaux qui l'ont produit, figés au
  /// moment de la décision. Les poids peuvent changer ; ce qui a été décidé
  /// hier doit rester explicable demain.
  riskScore   Int
  riskSignals Json

  /// Points effectivement crédités. `0` tant que le statut n'est pas `APPROVED` —
  /// une ligne existe donc même quand rien n'a été versé, et c'est le but.
  points Int @default(0)

  decidedAt DateTime @default(now())

  /// Revue humaine d'un `PENDING_REVIEW`.
  reviewedById String?
  reviewedBy   User?     @relation("ReferralRewardReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?   @db.Text

  @@index([referrerId, decidedAt(sort: Desc)])
  @@index([status, decidedAt(sort: Desc)]) // file d'attente admin
}

enum ReferralRewardStatus {
  APPROVED // point versé au parrain
  PENDING_REVIEW // rien versé, en attente d'un arbitrage humain
  REJECTED // rien versé, refus motivé
}

/// Installation applicative d'où un compte s'est connecté.
///
/// L'identifiant est un UUID **généré par le client** et persisté localement
/// (`shared_preferences` / `localStorage`). Aucune donnée matérielle n'est
/// collectée : ni IMEI, ni adresse MAC, ni numéro de série.
///
/// ⚠️ **C'est un signal, jamais une preuve d'identité.** Il disparaît à la
/// désinstallation et se partage dans une famille : il pondère une décision de
/// récompense, il ne bloque jamais un compte à lui seul (`ReferralRiskService`).
model DeviceInstallation {
  id             String @id @default(cuid())
  installationId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// « android » | « ios » | « web » — déclaré par le client, indicatif.
  platform String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  status DeviceInstallationStatus @default(ACTIVE)

  /// Une ligne par couple installation/compte : c'est la multiplicité de ce
  /// couple qui est le signal, donc elle doit être comptable.
  @@unique([installationId, userId])
  @@index([installationId])
  @@index([userId])
}

enum DeviceInstallationStatus {
  ACTIVE
  FLAGGED // marquée par un administrateur après revue
  BLOCKED // aucune récompense de parrainage depuis cette installation
}

enum LoyaltyTransactionType {
  ORDER_SPEND // points dépensés au checkout
  ORDER_EARN // points gagnés à la livraison
  CANCELLATION_REFUND // recrédit des points à l'annulation
  REFERRAL_REFERRER // récompense du parrain
  /// Bonus de bienvenue du filleul — **supprimé du programme** en septembre 2026
  /// (le filleul ne reçoit plus rien, seul le parrain est récompensé). La valeur
  /// reste dans l'enum : des écritures historiques la portent, et un enum
  /// PostgreSQL ne se rétrécit pas sans réécrire les lignes existantes.
  REFERRAL_REFERRED
  ADJUSTMENT // écriture manuelle (admin) / migration de barème / héritée
}

model FcmToken {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String

  @@index([userId])
}

/// Une adresse enregistrée par un client.
///
/// Elle porte depuis septembre 2026 sa **propre** position géographique. Sans
/// elle, la seule coordonnée disponible au moment de commander était le GPS du
/// téléphone : commander depuis son bureau pour une livraison à domicile
/// envoyait le livreur au bureau. « Où je suis » et « où on me livre » sont
/// deux informations distinctes, et seule la seconde appartient à l'adresse.
model Adresses {
  id         String    @id @default(cuid())
  rue        String
  ville      String
  etat       String? // Région/État
  country    String
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  isDefault  Boolean   @default(false)
  quartier   Quartier? @relation(fields: [quartierId], references: [id])
  quartierId String? // Référence au quartier pour le calcul des frais
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// Position posée par le client sur la carte. `null` tant qu'il ne l'a pas
  /// fait — les adresses créées avant cette évolution n'en ont pas, et on
  /// n'en invente pas : `locationPrecision` dit la vérité à leur sujet.
  latitude          Float?
  longitude         Float?
  /// Qualité de la position ci-dessus. Portée par la donnée elle-même plutôt
  /// que déduite d'un `latitude == null` : le repli sur le centroïde du
  /// quartier produit des coordonnées bien réelles mais approximatives, et
  /// rien ne les distinguerait sinon d'un point posé à la main.
  locationPrecision LocationPrecision @default(UNKNOWN)
  /// Repères pour le livreur : « portail bleu face à la pharmacie ». À
  /// Brazzaville, cette phrase vaut souvent mieux qu'un numéro de rue.
  landmark          String?
  /// Nom donné par le client : « Maison », « Bureau ».
  label             String?

  @@index([userId])
  @@index([quartierId])
  // Tableau de bord « adresses à compléter » : sans lui, la seule façon de
  // lister les adresses sans position est un scan complet de la table.
  @@index([locationPrecision])
}

/// Fiabilité d'une position de livraison.
///
/// Trois valeurs, pas plus : ce sont les trois seules situations qui appellent
/// une **conduite différente** de la part du livreur et de l'interface.
enum LocationPrecision {
  /// Point posé par le client sur la carte. Le livreur peut s'y fier.
  EXACT

  /// Centroïde du quartier, faute de mieux. Le livreur doit appeler.
  /// ⚠️ Ne jamais l'afficher comme une position exacte.
  APPROXIMATE

  /// Aucune coordonnée. On n'affiche **aucun** marqueur — un faux point est
  /// pire que pas de point du tout.
  UNKNOWN
}

model Restaurant {
  id            String  @id @default(cuid())
  nom           String
  // Présentation du commerce au client. Le modèle n'avait aucun champ libre :
  // le seul emplacement descriptif était `VendorProfile.story`, réservé de fait
  // aux vendeurs non-RESTAURANT par les formulaires d'admin.
  description   String? @db.Text
  // E-mail de contact du commerce, distinct de celui du propriétaire : le
  // compte owner sert à se connecter, cette adresse est publiable.
  email         String?
  adresse       String
  phone         String
  imageUrl      String?
  // `public_id` Cloudinary du logo. Sans lui, remplacer l'image d'un vendeur
  // laissait l'ancienne dans Cloudinary sans aucun moyen de la retrouver :
  // `VendorPhoto`, `ProductImage` et `MenuImage` le stockent tous, `Restaurant`
  // était le seul porteur d'image à ne pas le faire.
  imagePublicId String?

  //Ajout 04/04
  latitude  Float?
  longitude Float?

  // Localisation structurée (onboarding, août 2026). L'adresse restait une
  // chaîne libre : impossible de rattacher un vendeur à une zone de livraison
  // ni de le filtrer géographiquement. La ville n'est pas dupliquée ici, elle
  // vient de `Quartier.ville`.
  quartier             Quartier? @relation(fields: [quartierId], references: [id])
  quartierId           String?
  // Repères pour le livreur : « portail bleu face à la pharmacie ».
  deliveryInstructions String?

  owner       User          @relation(fields: [ownerId], references: [id])
  ownerId     String        @unique
  products    Product[]
  menuDuJour  MenuDuJour[]
  orders      Order[]
  reviews     Review[]
  favorites   Favorite[]
  categories  Category[] // Sections de menu propres à ce vendeur
  specialties Specialty[] // Spécialités du restaurant
  banners     Banner[] // Bannières du restaurant
  photos      VendorPhoto[] // Galerie photos vendeur

  // Statut d'activité (contrôlé par l'admin)
  isActive Boolean @default(true) // Restaurant actif/désactivé par l'admin

  // ─── Mise en ordre et mise en avant (septembre 2026) ───────────────────────
  //
  // ⚠️ Ni l'un ni l'autre ne décide de la VISIBILITÉ. Celle-ci reste portée par
  // `PUBLIC_VENDOR_WHERE` (onboardingStatus + adminApproved + isActive), qui
  // vit dans le `where` ; ces deux colonnes vivent dans l'`orderBy` et le
  // `select`. Deux clauses SQL différentes, qui ne peuvent structurellement pas
  // se contaminer : un vendeur DRAFT avec `displayOrder = 1` reste invisible.
  //
  /// Position voulue par l'administrateur. Plus petit = plus haut.
  ///
  /// Défaut volontairement élevé, et non `0` : avec `0`, « pas encore classé »
  /// et « tout premier » seraient la même valeur, et chaque nouveau vendeur
  /// atterrirait en tête du catalogue par accident. À 1000, il se range
  /// derrière ceux qu'on a explicitement classés, et le départage se fait par
  /// date de création comme avant.
  ///
  /// Les doublons sont autorisés : « ces deux-là en premier, l'ordre entre eux
  /// m'est égal » est une intention légitime, et un `@@unique` obligerait à
  /// réécrire toute la colonne à chaque insertion.
  displayOrder Int @default(1000)

  /// Mise en avant éditoriale, décidée par un administrateur.
  ///
  /// **Indépendante de `displayOrder`** : l'une dit « où », l'autre « avec un
  /// badge ». Un vendeur peut être mis en avant en 10e position, ou premier
  /// sans badge.
  ///
  /// Un booléen et non un enum de badges : « Nouveau » se dérive de
  /// `createdAt`, « Populaire » du nombre de commandes — les stocker en
  /// colonne créerait des données qui deviennent fausses toutes seules. Il ne
  /// reste qu'une seule décision proprement humaine, et un enum à une valeur
  /// utile est un booléen avec plus de cérémonie.
  isFeatured Boolean @default(false)

  // Avancement de la configuration — orthogonal aux trois booléens ci-dessus.
  //
  // `adminApproved` (validation marketplace), `isActive` (suspension) et
  // `isOpen` (ouvert maintenant) répondent chacun à une question différente et
  // peuvent varier indépendamment : un vendeur peut être approuvé, suspendu et
  // fermé en même temps. Il manquait la quatrième question — « sa boutique
  // est-elle configurée ? » — à laquelle aucun des trois ne répond.
  //
  // Trois valeurs suffisent : le détail de l'avancement (quelles cases sont
  // cochées) est **calculé** par VendorReadinessService à partir des données
  // elles-mêmes. Le stocker en colonne créerait une seconde vérité qui se
  // désynchroniserait au premier écrit hors service.
  onboardingStatus OnboardingStatus @default(DRAFT)
  activatedAt      DateTime?
  activatedById    String? // User.id de l'admin qui a activé (pas de FK, comme adminApprovedById)

  // Statut d'ouverture.
  //
  // Le défaut est passé de `true` à `false` (onboarding, août 2026) : le cron
  // d'ouverture ignorait les vendeurs sans horaires, si bien qu'un vendeur créé
  // et jamais configuré restait « ouvert » en permanence et acceptait des
  // commandes à 3 h du matin. Naître fermé est le défaut sûr ; le cron ouvre
  // dès qu'il y a des horaires à respecter.
  isOpen         Boolean          @default(false)
  manualOverride Boolean          @default(false) // Si true, le cron ne modifie pas isOpen
  operatingHours OperatingHours[]
  /// F3-03 — pause qui se termine seule (« fermé jusqu'à 14:30 »). Bornée à
  /// 7 jours : au-delà, c'est un congé (`VendorClosure`). Prime sur les
  /// horaires et sur `manualOverride`.
  pausedUntil      DateTime?
  pauseReason      String?
  /// F3-03 — fermé les jours de `PublicHoliday`.
  closedOnHolidays Boolean          @default(true)
  closures         VendorClosure[]
  promoCodes     PromoCode[]      @relation("RestaurantPromoCodes")

  // Configuration de la livraison
  deliveryPriceMode        DeliveryPriceMode @default(FIXED)
  fixedDeliveryFee         Int               @default(1000) // Prix fixe si mode FIXED, en XAF entiers
  deliveryZones            DeliveryZone[] // Zones de livraison si mode ZONE_BASED

  // Tarification plateforme (Phase 3, F3-02). Le vendeur ne fixe plus le prix
  // de la course — base de la paie livreur — il peut seulement en OFFRIR une
  // partie, déduite de son reversement.
  deliverySubsidyMode      DeliverySubsidyMode @default(NONE)
  /// FIXED : montant offert par commande (plafonné au prix de base).
  deliverySubsidyXaf       Int?
  /// FREE_ABOVE : livraison offerte dès ce sous-total.
  freeDeliveryThresholdXaf Int?
  estimatedDeliveryTimeMin Int               @default(15) // Temps de livraison min (minutes)
  estimatedDeliveryTimeMax Int               @default(30) // Temps de livraison max (minutes)
  minimumOrderAmount       Int               @default(0) // Montant minimum de commande, en XAF entiers

  // Modes de service acceptés. `Order.isDelivery` existait déjà, mais c'est un
  // choix du client par commande : rien n'exprimait qu'un vendeur ne livre pas,
  // ou ne fait que de la livraison. Les deux à `true` reproduisent le
  // comportement historique.
  supportsDelivery Boolean @default(true)
  supportsPickup   Boolean @default(true)

  // Commission prélevée par la plateforme sur ce vendeur, en pourcentage.
  // `null` = taux plateforme (`PlatformSettings.restaurantCommissionPercent`).
  // Réservé à l'ADMIN : un vendeur qui pourrait fixer sa propre commission
  // fixerait la marge de Lilia.
  //
  // ⚠️ À ne pas confondre avec `PlatformSettings.serviceFeePercent` : celui-ci
  // est un frais payé EN PLUS par le client, celle-là est retenue SUR le
  // vendeur. Deux flux d'argent opposés — les confondre facturerait deux fois.
  commissionPercent Float?

  // ─── Coordonnées de reversement (payout, août 2026) ────────────────────────
  //
  // Distinctes de `Restaurant.phone` (numéro de contact, affiché au client et
  // au livreur) et du téléphone du compte propriétaire. Rien ne dit que le
  // numéro sur lequel on appelle le restaurant est celui sur lequel il veut
  // être payé : c'est souvent un numéro de gérance, parfois un autre opérateur.
  // Envoyer de l'argent sur un numéro deviné n'est pas rattrapable.
  //
  // Les deux doivent être renseignés pour qu'un reversement soit possible ;
  // `RestaurantPayoutService` refuse en 409 avec un message nominatif sinon.
  payoutPhoneNumber  String? // MSISDN, chiffres uniquement, indicatif inclus (242…)
  payoutProvider     PayoutProvider? // opérateur du compte de reversement
  /// Nom du titulaire du compte mobile money, pour le contrôle humain avant
  /// envoi. Purement informatif — jamais transmis au prestataire.
  payoutAccountName  String?
  /// Vérification humaine des coordonnées par un administrateur.
  payoutVerifiedAt   DateTime?
  payoutVerifiedById String? // User.id (pas de FK, comme adminApprovedById)

  payouts RestaurantPayout[]

  // Multi-vendeurs (Sprint A — LIL-111)
  vendorType        VendorType     @default(RESTAURANT)
  // Défaut sûr (fix L10, audit du 28/08/2026) : la valeur par défaut était
  // `true` et la règle « false hors RESTAURANT » ne vivait que dans les
  // services. Toute création qui contournerait ces services (script, seed,
  // futur endpoint) publiait donc un vendeur non validé. Les trois chemins de
  // création posent explicitement `adminApproved = true` pour les restaurants.
  adminApproved     Boolean        @default(false)
  adminApprovedAt   DateTime?
  adminApprovedById String? // User.id de l'admin qui a approuvé (pas de FK)
  acceptsPreorders  Boolean        @default(false)
  preorderLeadHours Int? // délai minimum en heures (ex: 24)
  minAgeRequired    Int? // Réservé futur — désactivé côté code (LIL-112)
  maxOrdersPerDay   Int? // null = illimité
  vendorProfile     VendorProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorType, isActive, adminApproved]) // marketplace filtering
  @@index([vendorType, isOpen]) // vendeurs ouverts par type
  @@index([onboardingStatus, adminApproved, isActive]) // frontière de visibilité publique
  // Frontière de visibilité + tri : couvre la requête du catalogue public, qui
  // filtre sur les trois premières colonnes puis trie sur la quatrième.
  @@index([onboardingStatus, adminApproved, isActive, displayOrder])
  @@index([quartierId])
}

/// Avancement de la configuration d'un vendeur (onboarding, août 2026).
///
/// Volontairement court. Les états intermédiaires qu'on serait tenté d'ajouter
/// (« informations saisies », « photos ajoutées », « catalogue rempli ») sont
/// des vues sur les données, pas des états du vendeur : `VendorReadinessService`
/// les dérive, ce qui garantit qu'ils ne peuvent jamais mentir.
enum OnboardingStatus {
  DRAFT // en cours de configuration — jamais exposé au client
  READY // checklist satisfaite, en attente d'activation par un admin
  ACTIVATED // activé ; la visibilité dépend alors de adminApproved + isActive
}

// Profil enrichi pour les vendeurs non-restaurant (Sprint A — LIL-111)
model VendorProfile {
  id           String     @id @default(cuid())
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  story          String? // Récit du vendeur affiché sur sa page
  certifications String[] // ["Fait maison", "Bio", "Importé direct"]
  specialties    String[] // ["Vins de Bordeaux", "Whisky écossais"]

  licenseNumber String? // BEVERAGE_SHOP : numéro de licence alcool

  nextAvailableSlot DateTime? // HOME_COOK / BAKERY
  productionNote    String? // "Commandez 24h à l'avance"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Spécialités d'un restaurant (ex: "Pizza", "Sushi", "Burgers", "Africain")
model Specialty {
  id           String     @id @default(cuid())
  name         String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, name]) // Une spécialité unique par restaurant
  @@index([restaurantId])
}

/// Section de la carte d'un vendeur — « Plats », « Accompagnements »,
/// « Spécialités Maison ».
///
/// **Appartient à un vendeur, et à un seul.** Jusqu'au 3 septembre 2026 cette
/// table était globale (`nom @unique`, aucun `restaurantId`) tout en étant
/// **ouverte en écriture au rôle RESTAURATEUR** : n'importe quel commerçant
/// pouvait créer ou renommer une entrée du vocabulaire de toute la plateforme,
/// affichée sur l'accueil de chaque client. C'était la seule table sans
/// propriétaire, et la seule modifiable par des tiers.
///
/// La taxonomie **plateforme** n'a pas disparu pour autant : elle est portée
/// par les enums `VendorType` et `ProductType`, possédés par le code, validés
/// par une matrice, et déjà consommés par les deux clients pour la découverte.
/// Il n'y a donc pas de troisième taxonomie à inventer — seulement un
/// propriétaire à donner à celle-ci.
model Category {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String

  /// Libellé affiché, tel que saisi par le vendeur.
  nom         String
  /// Dérivé de `nom` (minuscules, sans accent ni ponctuation). C'est LUI qui
  /// porte l'unicité : « Boissons » et « boissons » désignent la même section,
  /// alors que l'ancien `nom @unique` les acceptait toutes deux — une
  /// contrainte à la fois trop rigide entre vendeurs et inopérante chez un seul.
  slug        String
  description String?
  imageUrl    String?

  /// Ordre voulu par le vendeur. Sans lui, les clients triaient
  /// alphabétiquement (mobile) ou par date de création des produits (web) :
  /// aucun commerçant ne maîtrisait l'ordre de sa propre carte.
  displayOrder Int     @default(0)
  /// Masquée au client sans être supprimée. Ses produits restent vendables et
  /// remontent dans « Autres ».
  isActive     Boolean @default(true)

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Deux vendeurs peuvent avoir « Boissons ». Un vendeur ne peut pas l'avoir
  /// deux fois.
  @@unique([restaurantId, slug])
  /// Cible de la clé étrangère **composite** portée par `Product` : c'est elle
  /// qui rend structurellement impossible qu'un produit du vendeur A référence
  /// une catégorie du vendeur B. Sans elle, l'isolation ne tiendrait qu'à un
  /// `if` dans un service — et la première écriture hors service la percerait.
  @@unique([id, restaurantId])
  @@index([restaurantId, displayOrder])
}

model MenuDuJour {
  id             String        @id @default(cuid())
  nom            String
  description    String?
  imageUrl       String?
  /// Montant en francs CFA — entier (voir `Product.prixOriginal`).
  prix           Int
  type           MenuType      @default(COMBO) // COMBO = multi-produits, PLAT_SPECIAL = plat unique
  ingredients    String? // Composition du plat special (texte libre, ex: "Riz, poulet, legumes")
  stockQuotidien Int? // Quantite disponible par jour (null = illimite)
  stockRestant   Int? // Quantite restante aujourd'hui (null = illimite)
  dateDebut      DateTime // Date et heure de début de validité du menu
  dateFin        DateTime // Date et heure de fin de validité du menu
  isActive       Boolean       @default(true) // Permet de désactiver manuellement un menu
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id])
  restaurantId   String
  products       MenuProduct[] // Relation many-to-many avec Product
  orderItems     OrderItem[]
  cartItems      CartItem[]
  images         MenuImage[] // Galerie photos menu
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([restaurantId])
  @@index([dateDebut, dateFin]) // Index pour les requêtes par date
}

// Table de liaison pour la relation many-to-many entre Menu et Product
model MenuProduct {
  id        String     @id @default(cuid())
  menu      MenuDuJour @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuId    String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  ordre     Int        @default(0) // Ordre d'affichage dans le menu
  createdAt DateTime   @default(now())

  @@unique([menuId, productId]) // Un produit ne peut être ajouté qu'une seule fois dans un menu
  @@index([menuId])
  @@index([productId])
}

model Product {
  id             String           @id @default(cuid())
  nom            String
  description    String?
  imageUrl       String?
  /// Montant en francs CFA. `Int` depuis le 03/09/2026 : le XAF n'a pas de
  /// sous-unité, et les DTO imposaient déjà `@IsInt` (fix B-6) — la colonne
  /// était le dernier endroit où « 1 250,5 FCFA » restait représentable.
  prixOriginal   Int
  stockQuotidien Int? // Quantite disponible par jour (null = illimite)
  stockRestant   Int? // Quantite restante aujourd'hui (null = illimite)
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id])
  restaurantId   String
  /// Section de menu du vendeur. Optionnelle : **une catégorie ne doit jamais
  /// empêcher de créer un produit.**
  ///
  /// La relation est **composite** — elle joint sur `(categoryId, restaurantId)`
  /// — pour que PostgreSQL refuse lui-même un produit du vendeur A rattaché à
  /// une catégorie du vendeur B. `onDelete` est en `Restrict` et non `SetNull` :
  /// `restaurantId` étant obligatoire, un `SET NULL` sur les deux colonnes
  /// serait invalide. Le détachement des produits est donc fait explicitement,
  /// dans la transaction de suppression (`CategoriesService.remove`).
  category       Category?        @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  categoryId     String?
  variants       ProductVariant[]
  menus          MenuProduct[] // Relation many-to-many avec MenuDuJour
  orderItems     OrderItem[]
  cartItems      CartItem[]
  images         ProductImage[] // Galerie photos produit

  // Multi-vendeurs (Sprint A — LIL-111)
  productType ProductType @default(FOOD)
  stockMode   StockMode   @default(DAILY) // PERMANENT n'est pas reset par le cron

  // Métadonnées alcool (productType = ALCOHOL)
  alcoholContent Float? // % vol, ex: 40.0
  vintage        Int? // millésime, ex: 2019
  origin         String? // "Bordeaux, France"
  volumeMl       Int? // volume en ml, ex: 750

  // Métadonnées fait maison / pâtisserie
  ingredients   String? // liste pour info allergènes
  shelfLifeDays Int? // durée conservation en jours
  madeToOrder   Boolean @default(false)

  // Disponibilité horaire (BAKERY surtout) — appliquée au catalogue ET au
  // checkout depuis l'audit du 28/08/2026 (fix M1). Auparavant validée à
  // l'écriture puis jamais relue : une viennoiserie du matin restait
  // commandable à 3 h.
  availableFrom  String? // "HH:mm"
  availableUntil String? // "HH:mm"

  // Disponibilité et retrait du catalogue (fix M2).
  //
  // `OrderItem.productId` est en RESTRICT depuis Ar1 : `DELETE /products/:id`
  // renvoyait 409 dès la première vente, et le seul contournement
  // (`stockQuotidien = 0`) affiche « épuisé » et non « retiré ». Deux notions
  // distinctes :
  //  - `isAvailable = false` : temporairement indisponible, le vendeur le
  //    remettra ;
  //  - `deletedAt` : retiré du catalogue pour de bon, mais la ligne survit
  //    pour que l'historique des commandes reste lisible.
  isAvailable Boolean   @default(true)
  deletedAt   DateTime?

  /// Position du produit dans sa section, voulue par le vendeur.
  /// Plus petit = plus haut.
  ///
  /// C'était la **seule** entité ordonnable de la carte à ne pas en avoir :
  /// `Category`, `Banner`, `ProductImage`, `VendorPhoto`, `MenuImage` et
  /// `MenuProduct` en portaient une, pas le produit. Les deux clients triaient
  /// donc différemment — `createdAt desc` sur le web, **rien du tout** sur
  /// mobile, c'est-à-dire l'ordre que PostgreSQL veut bien rendre, qui change
  /// dès qu'une ligne est mise à jour. Constaté sur les 4 vendeurs de
  /// production le 06/09/2026 : ordre différent des deux côtés, partout.
  ///
  /// Défaut `1000` et non `0`, comme `Restaurant.displayOrder` et pour la même
  /// raison : avec `0`, « pas encore classé » et « tout premier » seraient la
  /// même valeur, et chaque nouveau produit passerait en tête de section par
  /// accident. À 1000, tout le catalogue existant reste à égalité et le tri
  /// secondaire (`createdAt desc`) le départage — **l'ordre affiché aujourd'hui
  /// sur le web est donc préservé à l'octet près** tant qu'aucun vendeur n'a
  /// classé quoi que ce soit.
  ///
  /// Les doublons sont autorisés : le tri secondaire existe pour ça.
  displayOrder Int @default(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, productType]) // catalogue par type
  @@index([productType, stockMode]) // cron reset DAILY uniquement
  @@index([restaurantId, deletedAt, isAvailable]) // catalogue vendeur filtré (fix M2)
  /// Tri du menu : on lit toujours « les produits d'un vendeur, dans l'ordre ».
  @@index([restaurantId, displayOrder])
}

/// Format d'un produit — « 30cl », « Grand », « Standard ».
///
/// ⚠️ **Aucun ordre déclaré par le vendeur.** Les lectures trient par `prix`
/// croissant (voir `MENU_VARIANTS_ORDER_BY`), et c'est délibéré : inventer un
/// `displayOrder` de variante imposerait une interface de classement que
/// personne n'a demandée, alors que le seul besoin réel est un ordre
/// **déterministe**. Sans `orderBy`, PostgreSQL rendait les variantes dans
/// l'ordre de son tas, si bien que « le prix de la première variante » —
/// affiché sur les deux catalogues — pouvait changer après une simple édition.
model ProductVariant {
  id        String     @id @default(cuid())
  label     String? // e.g., "30cl", "1.5L", "Normal", "Grand"
  /// Montant en francs CFA — entier (voir `Product.prixOriginal`).
  prix      Int
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  cartItems CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([productId])
  /// Sert le tri du menu (`prix asc`) sans passer par un tri en mémoire.
  @@index([productId, prix])
}

model Cart {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id])
  userId    String     @unique // Un utilisateur a un seul panier
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product        @relation(fields: [productId], references: [id])
  productId String
  menu      MenuDuJour?    @relation(fields: [menuId], references: [id])
  menuId    String?
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String
  quantite  Int
  createdAt DateTime       @default(now())

  // ⚠️ En PostgreSQL, `NULL != NULL` : cette contrainte ne protège PAS les
  // lignes `menuId = null`, c'est-à-dire les produits individuels — soit le cas
  // le plus fréquent (fix L9). Un index unique **partiel**
  // `WHERE "menuId" IS NULL` la complète, créé par la migration
  // `20260828200000_cart_item_partial_unique` (Prisma ne sait pas déclarer un
  // index partiel).
  @@unique([cartId, variantId, menuId]) // Permet un même variant comme produit individuel ET dans un menu
  @@index([variantId])
  @@index([productId])
  @@index([menuId])
}

// 04/04/2026 ÉTAPE 1 — Ajouter les nouveaux enums (non-breaking)

model Order {
  id                 String            @id @default(cuid())
  restaurant         Restaurant        @relation(fields: [restaurantId], references: [id])
  restaurantId       String
  user               User              @relation(fields: [userId], references: [id])
  userId             String
  /// Montants en francs CFA — **entiers** (dette M12 soldée le 03/09/2026).
  ///
  /// Le XAF n'a pas de sous-unité : « 1 250,5 FCFA » ne veut rien dire. Tous
  /// les calculs passaient déjà par `Math.round` ou `money.util.ts` ; la
  /// colonne restait le dernier endroit où une décimale était représentable —
  /// et donc où une écriture hors service pouvait en introduire une.
  subTotal           Int // Sous-total des articles
  deliveryFee        Int // Frais de livraison (0 si retrait), APRÈS remise
  /// Tarif de livraison **avant remise commerciale**, figé à la commande.
  ///
  /// `deliveryFee` porte la valeur après promo : un code `FREE_DELIVERY` le met
  /// à 0 (`promo.service.ts`). Rémunérer le livreur dessus lui ferait porter une
  /// campagne marketing qu'il n'a pas décidée — il a roulé. Même règle que pour
  /// le vendeur, dont le reversement ignore déjà les remises.
  ///
  /// C'est cette colonne, et elle seule, qui sert d'assiette au partage de la
  /// course. Elle existe parce que la valeur brute n'était persistée nulle part
  /// et n'était reconstructible que par une soustraction à trois termes sur deux
  /// tables — un chemin de paiement ne repose pas sur une reconstruction.
  deliveryFeeGross   Int               @default(0)
  serviceFee         Int               @default(0) // frais de service payés par le client
  total              Int // subTotal + deliveryFee + serviceFee - discountAmount
  isDelivery         Boolean           @default(true) // true = livraison, false = retrait au restaurant
  deliveryAddress    String? // Adresse de livraison (null si retrait)
  // 04/04/2026
  orderHistory       OrderHistory[] // Historique des changements de statut
  // ── Destination de livraison, figée à la commande ──────────────────────
  // Snapshot délibéré : le client peut corriger son adresse le lendemain, la
  // commande d'hier doit continuer à pointer là où elle a été livrée. Même
  // raison que `OrderItem.snapshotPrice` et `Order.commissionPercent`.
  //
  // ⚠️ Depuis septembre 2026 ces coordonnées sont **résolues par le serveur**
  // à partir de `Adresses`, jamais reprises du corps de la requête : le client
  // envoyait le GPS de son téléphone, donc l'endroit où il se trouvait au
  // moment de payer et non celui où il voulait être livré.
  /// Fiabilité de la destination, figée elle aussi. Sans elle, l'app livreur
  /// ne peut pas distinguer un point posé à la main d'un centroïde de
  /// quartier — et afficherait les deux avec le même aplomb.
  deliveryPrecision  LocationPrecision @default(UNKNOWN)
  /// Repères du client, recopiés de l'adresse au moment de la commande.
  deliveryLandmark   String?
  deliveryLatitude   Float? // nouveau
  deliveryLongitude  Float? // nouveau  
  deliveryQuartierId String? // nouveau — pour les frais de zone
  deleteCommande     Boolean           @default(false)
  paymentMethod      PaymentMethod // Méthode de paiement
  status             OrderStatus       @default(EN_ATTENTE)
  paidAt             DateTime? // Date de paiement
  /// F3-05 — échec de livraison conclu par l'admin (`ECHEC_LIVRAISON`) : quand,
  /// pourquoi, et QUI en répond. Le responsable décide de l'argent (R-05.3).
  failedAt           DateTime?
  failureReason      DeliveryFailureReason?
  failureLiability   FailureLiability?
  failureDecidedBy   String?
  notes              String? // Notes optionnelles du client pour le restaurant
  contactPhone       String? // Numéro de téléphone saisi lors de la commande
  items              OrderItem[]
  reviews            Review[]
  delivery           Delivery?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  Payment        Payment[]
  promoCodeId    String?
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id])
  discountAmount Int        @default(0) // remise totale (promo + fidélité), en XAF

  /// Détail de la part « fidélité » de `discountAmount`, figée à la commande.
  ///
  /// `discountAmount` fusionnait promo et fidélité : mesurer le coût du
  /// programme imposait de rejouer le ledger, et rien ne permettait de savoir
  /// *a posteriori* combien de points une commande avait consommés — alors que
  /// c'est exactement ce que le garde-fou anti-boucle doit lire à la livraison.
  ///
  /// `loyaltyDiscount` est un **snapshot** : il vaut `loyaltyPointsUsed × la
  /// valeur du point au moment de la commande`. Il ne se recalcule pas, sans
  /// quoi un changement de barème réécrirait rétroactivement des montants
  /// encaissés — même raison que `commissionPercent` et `snapshotPrice`.
  loyaltyPointsUsed Int @default(0)
  loyaltyDiscount   Int @default(0)

  /// Récompense de parrainage que cette commande a validée, s'il y en a une.
  referralReward ReferralReward?

  // Commission plateforme figée au moment de la commande (onboarding, août
  // 2026). `Restaurant.commissionPercent` peut changer ; sans ce snapshot, un
  // changement de taux réécrirait rétroactivement ce que Lilia a prélevé sur
  // des commandes déjà encaissées — un chiffre comptable ne se recalcule pas.
  // Même raison que `OrderItem.snapshotPrice`.
  /// Taux, en pourcentage — reste `Float` : c'est une proportion, pas un
  /// montant. Un taux de 8,5 % est parfaitement légitime.
  commissionPercent Float @default(0)
  commissionAmount  Int   @default(0) // montant retenu sur subTotal, en XAF

  // Précommandes (Sprint A — LIL-111)
  isPreorder          Boolean   @default(false)
  scheduledFor        DateTime? // date/heure de livraison souhaitée
  preorderConfirmedAt DateTime? // confirmé par le vendeur

  // Acceptation vendeur (Phase 3, F3-01)
  /// Échéance au-delà de laquelle une commande `PAYER` non acceptée est annulée
  /// et remboursée. Figée au paiement (`acceptanceDeadline`) : changer le délai
  /// plateforme ne réécrit pas les commandes en cours. `null` pour l'historique.
  acceptDeadlineAt      DateTime?
  /// Acceptation par le vendeur — explicite (`POST /orders/:id/accept`) ou
  /// implicite (`PAYER → EN_PREPARATION` pendant la transition).
  acceptedAt            DateTime?
  /// Heure de fin de préparation annoncée au client à l'acceptation.
  estimatedReadyAt      DateTime?
  vendorRejectionReason VendorRejectionReason?
  vendorRejectionNote   String?

  // Tarification plateforme (Phase 3, F3-02) — figée à la commande.
  /// Version de la grille appliquée (`null` : tarif vendeur historique).
  deliveryTariffVersion    Int?
  /// Distance estimée vendeur → destination (km, × coefficient routier).
  deliveryDistanceKm       Float?
  /// Prix de base plateforme de la course = assiette de la paie livreur.
  deliveryFeeBaseXaf       Int?
  /// Part du prix offerte par le vendeur, déduite de SON reversement.
  vendorDeliverySubsidyXaf Int     @default(0)

  // Vérification d'âge (alcool — Sprint A — LIL-111)
  ageVerified   Boolean   @default(false)
  ageVerifiedAt DateTime?

  // Remboursements de la commande (fix H5, puis F3-06 : N par commande, au
  // plus un en vol — index unique partiel `Refund_orderId_inflight_uq`).
  refunds Refund[]

  /// Reversement au vendeur — au plus un par commande (`@@unique` côté
  /// `RestaurantPayout.orderId`). Absent tant qu'un administrateur ne l'a pas
  /// déclenché : encaisser le client et payer le vendeur sont deux décisions
  /// distinctes.
  payout RestaurantPayout?

  @@index([restaurantId, status, createdAt(sort: Desc)]) // dashboard resto: commandes par statut, plus recentes (LFD-9)
  @@index([promoCodeId])
  @@index([restaurantId])
  @@index([userId])
  @@index([status]) // ← manquait
  @@index([createdAt]) // ← manquait
  @@index([userId, createdAt(sort: Desc)]) // GET /orders/my — pagination client (fix M19)
  @@index([status, createdAt]) // cron d'expiration des commandes impayées (fix M19)
  @@index([status, acceptDeadlineAt]) // cron d'expiration des commandes non acceptées (F3-01)
}

model OrderItem {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product     @relation(fields: [productId], references: [id])
  productId String
  menu      MenuDuJour? @relation(fields: [menuId], references: [id])
  menuId    String?
  variant   String // e.g., "1.5L"
  quantite  Int
  prix      Int // XAF entiers
  createdAt DateTime    @default(now())

  // 04/04/2026
  variantId     String? // nullable pour les commandes existantes
  variantLabel  String? // snapshot du label au moment de la commande
  snapshotPrice Int? // snapshot du prix à la commande, en XAF

  /// F3-06 — lignes de remboursement partiel portant sur cet article.
  refundLines RefundLine[]

  @@index([orderId])
  @@index([productId])
  @@index([menuId])
}

/// Journal des transitions de statut d'une commande.
///
/// ⚠️ **Cette table est restée vide de sa création (avril 2026) à septembre
/// 2026** : le modèle existait, la relation existait, l'index existait, et
/// aucune ligne du backend ne l'écrivait (`grep -rni orderHistory apps/` → 0
/// résultat). Elle est alimentée depuis le chantier P0-4 par
/// `OrderTransitionService`, **seul** point d'écriture autorisé.
///
/// Conséquence à garder en tête pour toute requête analytique : une commande
/// antérieure à ce chantier n'a **aucune** ligne. Rien n'a été reconstruit — ni
/// depuis `Order.createdAt`, ni depuis `paidAt`, ni depuis les horodatages de
/// `Delivery`. Fabriquer un historique partiel à partir de ces colonnes aurait
/// produit un journal qui *a l'air* complet sans l'être, ce qui est pire que
/// son absence : `COUNT(*) = 0` se lit sans ambiguïté, une série trouée non.
model OrderHistory {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  /// Statut quitté. **`null` = création de la commande** — il n'y a pas d'état
  /// de départ, et l'enum ne peut pas en représenter un.
  ///
  /// L'alternative aurait été d'écrire `EN_ATTENTE → EN_ATTENTE` : cette ligne
  /// serait comptée comme une transition par toute agrégation de durée par
  /// étape, et fausserait précisément la mesure pour laquelle cette table
  /// existe. Rendre la colonne nullable n'a coûté aucune migration de données :
  /// la table était vide.
  fromStatus OrderStatus?
  toStatus   OrderStatus

  /// Rôle de l'auteur : `CLIENT`, `RESTAURATEUR`, `LIVREUR`, `ADMIN`, `SYSTEM`.
  ///
  /// Conserve son nom historique bien qu'il porte un rôle et non un
  /// identifiant : aucun consommateur ne le lit (la table n'a jamais été
  /// écrite), et le renommer n'apporterait rien qu'`actorUserId` ne donne déjà.
  /// Reste un `String` plutôt qu'un `Role` : `SYSTEM` n'est pas un rôle du
  /// RBAC, et l'y ajouter pour un besoin d'historique modifierait la sécurité
  /// de toute l'application pour un besoin local.
  actionId String

  /// `User.id` de l'auteur, quand il y en a un. `null` pour les transitions
  /// automatiques (cron, webhook, règlement d'une commande à zéro).
  ///
  /// Sans clé étrangère, comme `adminApprovedById`, `activatedById`,
  /// `requestedBy` et `processedBy` : convention déjà établie dans ce schéma
  /// pour les colonnes d'audit, qui doivent survivre à l'anonymisation d'un
  /// compte (`UserDeletionService`).
  actorUserId String?

  /// D'où vient le geste : `APP`, `ADMIN_APP`, `BACKEND`, `WEBHOOK`,
  /// `POLLING`, `CRON`. C'est ce qui distingue une transition **humaine** d'une
  /// transition automatique — donc ce qui rendra mesurable le taux
  /// d'acceptation vendeur.
  ///
  /// `String` et non enum Prisma, pour deux raisons : `actionId`, la colonne
  /// sœur, en est déjà un — mélanger les deux représentations pour deux facettes
  /// du même acteur serait incohérent ; et ajouter une valeur à un enum
  /// PostgreSQL impose un `ALTER TYPE … ADD VALUE` **non transactionnel**, dont
  /// ce dépôt a déjà payé le prix (migration `20260830120000`). Les valeurs
  /// admises sont bornées par `ORDER_TRANSITION_SOURCES` et un test.
  source String @default("BACKEND")

  /// Motif, quand l'appelant en fournit un (annulation, échec de livraison).
  reason String?

  createdAt DateTime @default(now())

  @@index([orderId])
  /// Agrégation des délais par étape (médiane, P90, P95) : la requête filtre
  /// sur `toStatus` puis borne `createdAt`. Créé maintenant, sur une table
  /// vide, il ne coûte rien ; ajouté plus tard sur plusieurs centaines de
  /// milliers de lignes, il coûterait un verrou.
  @@index([toStatus, createdAt])
}

enum DriverStatus {
  AVAILABLE
  ON_DELIVERY
  OFFLINE
}

/// Moyen de locomotion du livreur.
///
/// Ce n'est pas une information décorative : elle décide de ce qu'on peut lui
/// confier. Une moto et un vélo n'ont ni le même rayon d'action ni la même
/// capacité, et `PIETON` n'a pas de plaque à saisir — c'est ce champ qui rend
/// `plateNumber` pertinent ou non.
enum VehicleType {
  MOTO
  VELO
  VOITURE
  PIETON
}

/// Nature de la relation entre Lilia Food et le livreur.
///
/// Elle décide du taux par défaut **et** de qui supporte les coûts du véhicule.
/// Un livreur `INDEPENDENT` apporte sa moto et paie carburant, entretien,
/// réparations et assurance : ces coûts ne sont donc **jamais** des charges de
/// Lilia Food et n'ont, délibérément, aucune colonne ici.
enum DriverEmploymentType {
  LILIA
  INDEPENDENT
}

/// Comment un livreur est rémunéré.
///
/// Les trois valeurs existent dès le premier jour alors qu'une seule est
/// utilisée (`PER_DELIVERY`, décision D-1 du 18/09/2026). Ce n'est pas de
/// l'anticipation gratuite : c'est cet enum qui distingue
/// « `driverPayXaf = 0` parce que le livreur est au salaire » de
/// « `driverPayXaf` inconnu ». Sans lui, un zéro serait ambigu — et le système
/// refuse par principe de confondre « gratuit » et « on ne sait pas ».
///
/// Ajouter le salaire plus tard ne coûtera qu'une table de périodes de paie,
/// jamais une migration destructive sur l'historique des courses.
enum DriverCompensationModel {
  /// Salaire seul — le coût variable par course vaut 0, et c'est un vrai zéro.
  SALARY
  /// Part des frais de livraison, par course. Seul modèle actif au 18/09/2026.
  PER_DELIVERY
  /// Salaire + part par course. Le salaire reste un coût de PÉRIODE : il
  /// n'entre jamais dans la marge de contribution d'une commande.
  SALARY_PLUS_PER_DELIVERY
}

/// Informations métier du livreur.
///
/// Séparé de `User` plutôt que fondu dedans, pour deux raisons :
///
/// 1. ces colonnes n'ont de sens que pour un livreur — les porter sur `User`
///    ferait traîner à chaque client une demi-douzaine de colonnes nulles ;
/// 2. et surtout, l'existence de la ligne **est** la règle : `role = LIVREUR`
///    sans profil n'est plus un état atteignable. Avant septembre 2026, c'était
///    l'état nominal, et rien dans le système ne savait quel véhicule conduisait
///    un livreur, ni s'il avait le droit de rouler.
///
/// ⚠️ Trois notions distinctes ne doivent jamais être confondues :
///   · `User.statusUser`         — le compte est-il valide ? (ACTIVE / BLOCKED / DELETED)
///   · `DriverProfile.isActive`  — le livreur est-il en service sur la plateforme ?
///   · `User.driverStatus`       — est-il disponible **maintenant** ?
/// Un compte ACTIVE, un profil ACTIF et une disponibilité OFFLINE est un état
/// parfaitement normal : le livreur a fini sa journée.
model DriverProfile {
  id     String @id @default(cuid())
  userId String @unique
  /// `Cascade` : le profil n'a aucune valeur comptable et aucun sens sans son
  /// compte. Il est aussi supprimé explicitement par `UserDeletionService`
  /// (plaque et permis sont des données personnelles).
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleType   VehicleType @default(MOTO)
  /// Immatriculation. Vide pour `VELO` et `PIETON` — la validation métier vit
  /// dans le DTO, pas ici : une colonne ne peut pas exprimer « requis selon la
  /// valeur d'une autre colonne ».
  plateNumber   String?
  licenseNumber String?
  licenseExpiry DateTime?

  /// Quartiers d'affectation. Vide = toute la ville, ce qui est le comportement
  /// historique et reste le défaut : restreindre par défaut rendrait
  /// inassignables tous les livreurs existants au déploiement.
  zones Quartier[] @relation("DriverZones")

  // ─── Économie de la course (décisions D-1 / D-2 du 18/09/2026) ───────────

  /// Nature de la relation. `LILIA` par défaut : c'est ce qu'étaient les deux
  /// livreurs existants au moment de la migration, et le défaut le moins
  /// coûteux si personne ne tranche (Lilia garde 65 % de la course).
  employmentType DriverEmploymentType @default(LILIA)

  /// Modèle de rémunération appliqué à ce livreur.
  compensationModel DriverCompensationModel @default(PER_DELIVERY)

  /// Part de CE livreur sur les frais de livraison, en pourcentage.
  /// `null` = taux plateforme correspondant à son `employmentType`.
  ///
  /// ⚠️ C'est la part **du livreur**, pas celle de Lilia. La part de Lilia est
  /// toujours un résidu (`base − driverPay`), jamais une seconde colonne : deux
  /// valeurs indépendantes finissent par diverger, un résidu ne le peut pas.
  ///
  /// Le repli est résolu en UN seul endroit, `DriverCompensationResolver`.
  /// Le défaut de `Restaurant.commissionPercent` a montré ce que coûtent deux
  /// résolveurs concurrents : la commande disait 0 %, le virement prélevait 10 %.
  driverSharePercent Float?

  /// Le livreur est-il en service ? Décidé par un administrateur.
  /// Défaut `false` : un livreur qu'on vient de créer n'a pas encore été
  /// contrôlé. Les profils rétro-créés par la migration naissent `true`, sans
  /// quoi les livreurs en activité disparaîtraient de la file d'assignation.
  isActive      Boolean   @default(false)
  activatedAt   DateTime?
  /// `User.id` de l'admin qui a activé — pas de FK, comme `adminApprovedById`.
  activatedById String?

  /// Motif de la dernière désactivation, pour que la décision reste lisible.
  deactivationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Delivery {
  id          String         @id @default(cuid())
  order       Order          @relation(fields: [orderId], references: [id])
  orderId     String         @unique
  deliverer   User?          @relation(fields: [delivererId], references: [id])
  delivererId String?
  status      DeliveryStatus @default(EN_ATTENTE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  estimatedArrival DateTime? // ETA calculé
  // Horodatage des trois moments distincts de la course. `pickedUpAt` était
  // renseigné dès l'acceptation, ce qui en faisait une donnée fausse : il est
  // désormais écrit à la récupération réelle du repas.
  acceptedAt       DateTime? // le livreur a accepté et part au restaurant
  pickedUpAt       DateTime? // le livreur a le repas en main
  deliveredAt      DateTime? // timestamp réel de livraison
  /// F3-05 — déclaration d'échec. Couvre le règlement du livreur quand il
  /// n'est pas responsable (sa course échouée lui est payée).
  failedAt         DateTime?
  failureReports   DeliveryFailureReport[]

  // Position dernière connue du livreur
  lastLatitude   Float?
  lastLongitude  Float?
  lastPositionAt DateTime?
  locations      DeliveryLocation[]

  // ─── Snapshot économique de la course ────────────────────────────────────
  //
  // Écrit à l'ACCEPTATION, effacé sur ECHEC ou refus, immuable dès LIVRER.
  //
  // ⚠️ Ce n'est PAS un snapshot « écrit une seule fois », et la nuance compte.
  // La politique retenue (D-3, 18/09/2026) est « seul le livreur qui termine est
  // payé » : si A accepte puis échoue et que B livre, le snapshot DOIT être
  // réécrit pour B. Le figer à la première acceptation paierait B au tarif de A
  // et graverait l'économie d'un livreur défaillant.
  //
  // L'immuabilité réelle est portée par la machine à états, pas par une colonne
  // de verrou : une fois `Order.status = LIVRER`, toute réassignation est
  // refusée (`delivery-assignment.service.ts`), donc plus rien ne peut bouger.
  // L'invariant est donc « une course LIVRÉE ne voit jamais son économie
  // changer », pas « ces colonnes ne sont écrites qu'une fois ».
  //
  // Toutes nullables, sans aucun backfill : les courses antérieures n'ont pas
  // d'économie connue, et on ne l'invente pas. `null` dit la vérité.

  /// Assiette du partage — `Order.deliveryFeeGross`, donc AVANT remise.
  driverBaseXaf Int?

  /// Modèle appliqué. Sans lui, `driverPayXaf = 0` serait indistinguable de
  /// « inconnu » : au salaire, zéro est la bonne réponse et elle est connue.
  driverCompensationModel DriverCompensationModel?

  /// Nature de la relation AU MOMENT de la course. Un livreur peut passer
  /// d'indépendant à Lilia ; cette course-ci reste ce qu'elle était.
  driverEmploymentType DriverEmploymentType?

  /// Taux appliqué, en pourcentage. `null` quand le modèle est `SALARY`.
  driverSharePercent Float?

  /// Rémunération due au livreur pour CETTE course, en XAF.
  /// `0` est une valeur légitime (modèle `SALARY`, ou tarif de livraison nul) —
  /// c'est `driverCompensationModel` qui la rend lisible, pas le montant.
  driverPayXaf Int?

  /// Instant du gel. `null` = pas d'économie attachée à cette course, donc
  /// coût livreur **inconnu**. Une donnée, pas une déduction.
  driverEconomicsFrozenAt DateTime?

  /// Règlement qui couvre cette course, s'il existe.
  ///
  /// ⚠️ C'est CE champ qui interdit de payer deux fois la même course : une
  /// course rattachée n'est plus éligible au prochain arrêté de compte, et
  /// c'est la base qui l'arbitre, pas un `if`. Même raisonnement que
  /// `@@unique([orderId])` sur `restaurant_payouts`.
  driverSettlementId String?
  driverSettlement   DriverSettlement? @relation(fields: [driverSettlementId], references: [id], onDelete: SetNull)

  review DeliveryReview? // note laissée par le client après livraison

  /// ── Preuve de remise (Master Audit v1, F-06) ─────────────────────────────
  /// Le CODE vit dans `DeliveryHandover`, jamais ici : plusieurs routes
  /// renvoient la ligne `Delivery` entière au livreur. Une colonne l'aurait
  /// exposé à celui-là même qui doit le recevoir du client.
  handover           DeliveryHandover?
  /// Comment la remise a été attestée. `null` tant que non livrée.
  handoverMethod     DeliveryHandoverMethod?
  handoverVerifiedAt DateTime?

  /// Toutes les mains par lesquelles cette course est passée.
  assignments DeliveryAssignment[]

  @@index([driverSettlementId])
  // Sélection des courses réglables : un livreur, ses courses livrées, non
  // encore rattachées à un règlement.
  @@index([delivererId, status, driverSettlementId])
  @@index([delivererId, status]) // missions d'un livreur filtrees par statut (LFD-9)
  @@index([delivererId])
  @@index([status]) // ← manquait
}

/// Journal des mains par lesquelles une course est passée.
///
/// ## Pourquoi une table, et pas `OrderHistory`
///
/// `OrderHistory` enregistre les transitions de `Order.status`. Or une
/// assignation **ne change pas le statut de la commande** : on assigne dès
/// `PAYER`, on réassigne en `PRET` ou en `EN_ROUTE`, et la commande ne bouge
/// pas. Y loger l'assignation imposerait des lignes `PRET → PRET`, que toute
/// agrégation de durée par étape compterait comme une transition — c'est
/// exactement la raison pour laquelle `recordCreation` écrit `fromStatus = null`
/// plutôt que `EN_ATTENTE → EN_ATTENTE`.
///
/// ## Pourquoi pas `DeliveryAttempt` avec son économie propre
///
/// La politique est « seul le livreur qui TERMINE est payé » (D-3). Le coût
/// d'une tentative avortée est donc **connu et constant : zéro**. Recopier ici
/// les six colonnes économiques de `Delivery` stockerait des zéros, dupliquerait
/// la source que `DriverSettlementService` interroge, et inviterait quelqu'un à
/// les régler un jour. L'économie reste sur `Delivery` — une seule autorité.
///
/// ## Ce que cette table répond, et que rien ne répondait
///
/// qui était assigné · quand · combien de temps (`assignedAt` → `releasedAt`) ·
/// délai de réponse (`acceptedAt`) · pourquoi il a été retiré (`outcome` +
/// `releaseReason`) · **qui** a réassigné (`assignedByUserId`) · combien de fois
/// la course a changé de mains (`count`) · quel livreur a terminé (`COMPLETED`).
///
/// Append-only : une ligne ouverte (`releasedAt = null`) par course au plus.
model DeliveryAssignment {
  id         String   @id @default(cuid())
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String
  /// Dénormalisé : la supervision part toujours d'une commande, jamais d'une
  /// livraison. Évite une jointure sur l'écran d'incident.
  orderId    String

  deliverer   User   @relation("DelivererAssignments", fields: [delivererId], references: [id], onDelete: Restrict)
  delivererId String

  assignedAt DateTime @default(now())
  /// Auteur de l'assignation. `null` pour une assignation automatique — il n'y
  /// en a aucune aujourd'hui, la colonne le restera tant que le dispatch est
  /// humain.
  assignedByUserId String?
  /// Rôle de l'auteur (`ADMIN` / `RESTAURATEUR`). Conservé à part parce que le
  /// rôle d'un compte peut changer après coup ; celui qui a agi, non.
  assignedByRole   String

  /// Moment de l'acceptation par ce livreur. `null` = il n'a jamais répondu.
  acceptedAt DateTime?
  /// Moment où il a eu le repas en main. `null` = il n'est jamais parti.
  pickedUpAt DateTime?

  /// `null` tant que la tentative est en cours. C'est le discriminant de la
  /// ligne ouverte.
  releasedAt    DateTime?
  outcome       DeliveryAssignmentOutcome?
  releaseReason String?                    @db.Text

  /// La course en cours, pour une livraison donnée : une seule ligne ouverte.
  @@index([deliveryId, releasedAt])
  @@index([deliveryId, assignedAt])
  @@index([delivererId, assignedAt(sort: Desc)])
  @@index([orderId])
}

/// Comment une main s'est terminée.
///
/// `ORDER_CANCELLED` est distinct de `FAILED` : le livreur n'a rien manqué, la
/// commande a disparu sous lui. Les confondre le pénaliserait dans toute
/// statistique de fiabilité.
/// Code de remise d'une course (F-06) — table à part pour qu'aucune lecture
/// de `Delivery` ne l'embarque par défaut. Ne se lit que pour le CLIENT de la
/// commande (et l'ADMIN), et ne se compare qu'au moment de conclure.
model DeliveryHandover {
  deliveryId String   @id
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  /// 4 chiffres, généré au retrait du repas.
  code       String
  /// Tentatives consommées — y compris la bonne : chaque saisie coûte un essai,
  /// ce qui borne une rafale de requêtes parallèles comme une saisie à la main.
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
}

/// Comment la remise d'une course a été attestée (F-06).
enum DeliveryHandoverMethod {
  CODE // le livreur a saisi le code montré au client
  ADMIN_OVERRIDE // un administrateur a conclu la course (arbitrage, audité)
  UNVERIFIED // course sans code (antérieure au dispositif, ou code non exigé)
}

/// F3-05 — motif déclaré d'un échec de livraison.
enum DeliveryFailureReason {
  CUSTOMER_UNREACHABLE
  ADDRESS_NOT_FOUND
  CUSTOMER_REFUSED
  ACCIDENT
  LOST_OR_DAMAGED
  DRIVER_NO_SHOW // déclaré par le vendeur : personne n'est venu chercher
  OTHER
}

/// F3-05 — qui répond d'un échec conclu. Décide du remboursement client, du
/// reversement vendeur et de la paie livreur (matrice R-05.3).
enum FailureLiability {
  CLIENT
  DRIVER
  VENDOR
  PLATFORM
}

/// F3-05 — preuve d'un échec : qui l'a déclaré, où, et le protocole « client
/// injoignable » (appels, SMS, attente). `declaredAt` null = protocole en cours.
model DeliveryFailureReport {
  id                String                 @id @default(cuid())
  deliveryId        String
  delivery          Delivery               @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderId           String
  reportedBy        String
  reportedByRole    String
  reason            DeliveryFailureReason?
  note              String?
  latitude          Float?
  longitude         Float?
  /// Distance à la destination au moment de la déclaration (centroïde ou point).
  distanceToDestM   Int?
  callAttempts      Int                    @default(0)
  smsSentAt         DateTime?
  protocolStartedAt DateTime?
  declaredAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([orderId])
  @@index([deliveryId, declaredAt])
}

enum DeliveryAssignmentOutcome {
  /// Ce livreur a livré la commande. Seul cas où une rémunération est due.
  COMPLETED
  /// La course lui a été retirée au profit d'un autre livreur.
  REASSIGNED
  /// Il a rendu la mission avant de l'accepter.
  DECLINED
  /// Il a signalé un échec (avant ou après récupération).
  FAILED
  /// La commande a été annulée pendant qu'il la tenait.
  ORDER_CANCELLED
}

/// Note du LIVREUR par le client, après livraison.
///
/// Modèle distinct de `Review` (qui note un vendeur) plutôt qu'extension de
/// celui-ci : `Review.orderId` est `@unique`, donc y loger la note du livreur
/// interdirait de noter le restaurant ET le livreur pour la même commande. Et
/// rendre `Review.restaurantId` nullable pour un modèle polymorphe fragiliserait
/// les huit requêtes qui s'appuient dessus, sans rien simplifier.
///
/// `@@unique([deliveryId])` porte nativement la règle métier « une seule note
/// par livraison » : la contrainte est en base, pas seulement dans le service.
model DeliveryReview {
  id          String   @id @default(cuid())
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  deliveryId  String   @unique
  orderId     String // dénormalisé : évite une jointure sur l'écran « mes notes »
  deliverer   User     @relation("DelivererReviews", fields: [delivererId], references: [id], onDelete: Restrict)
  delivererId String
  user        User     @relation("CustomerDeliveryReviews", fields: [userId], references: [id], onDelete: Restrict)
  userId      String
  rating      Int // 1 à 5, borné par le DTO
  comment     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([delivererId, createdAt(sort: Desc)]) // historique + moyenne du livreur
  @@index([delivererId, rating]) // agrégats (groupBy) sans charger les lignes
  @@index([userId])
}

// Nouvelle table — n'affecte pas l'existant
model DeliveryLocation {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float? // précision GPS en mètres
  recordedAt DateTime @default(now())

  @@index([deliveryId, recordedAt])
}

enum Role {
  ADMIN
  RESTAURATEUR
  LIVREUR
  CLIENT
}

enum StatusUser {
  INACTIVE
  ACTIVE
  BLOCKED
  // Compte supprimé par son propriétaire (DELETE /users/me). La ligne User est
  // conservée anonymisée : Order/Payment sont des pièces comptables qu'on ne
  // peut pas effacer, et elles portent une FK vers User depuis Ar1.
  DELETED
}

/// Opérateur choisi par le CLIENT pour payer.
enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY
}

/// Opérateur du compte sur lequel un VENDEUR est reversé.
///
/// Enum distinct de `PaymentMethod` bien que les valeurs se ressemblent : les
/// deux répondent à des questions différentes et n'évolueront pas ensemble (un
/// reversement pourra un jour se faire par virement bancaire, ce qui n'a aucun
/// sens comme moyen de paiement client au Congo). Les fondre créerait un
/// couplage entre l'encaissement et le reversement — exactement ce que ce
/// chantier sépare.
enum PayoutProvider {
  MTN_MOMO
  AIRTEL_MONEY
}

enum OrderStatus {
  EN_ATTENTE
  PAYER
  /// Le vendeur a vu et accepté la commande payée ; il n'a pas encore commencé
  /// (Phase 3, F3-01). Sépare « j'ai accepté » de « je prépare » : c'est ce qui
  /// rend mesurables le taux d'acceptation et le délai de réponse vendeur.
  ACCEPTEE
  EN_PREPARATION
  PRET
  EN_ROUTE
  LIVRER
  ANNULER
  /// Terminal : le repas est parti et n'est pas arrivé (Phase 3, F3-05). Posé
  /// dès maintenant pour ne payer qu'une fois l'`ALTER TYPE` non
  /// transactionnel ; aucune transition n'y mène encore.
  ECHEC_LIVRAISON
}

/// Motif d'un refus de commande par le vendeur (liste fermée : un texte libre
/// dans une pièce financière devient illisible en agrégat).
enum VendorRejectionReason {
  OUT_OF_STOCK
  TOO_BUSY
  CLOSING
  OUT_OF_ZONE
  OTHER
}

enum DeliveryStatus {
  EN_ATTENTE // livraison créée, aucun livreur
  ASSIGNER // un livreur est désigné, il n'a pas encore répondu
  // Le livreur a accepté et se rend au restaurant. Il n'a PAS le repas.
  //
  // Cet état manquait : `acceptDelivery` faisait passer la livraison
  // directement en EN_TRANSIT, écrivait `pickedUpAt` et basculait la commande
  // en EN_ROUTE — le client recevait « votre livreur est en chemin » alors que
  // le livreur n'avait encore rien récupéré. Accepter une mission n'est pas
  // être en route vers le client.
  ACCEPTER
  EN_TRANSIT // repas récupéré, le livreur roule vers le client
  LIVRER
  ECHEC
}

/// Encaissement auprès du CLIENT (collection). À ne pas confondre avec
/// `RestaurantPayout`, qui est le reversement au vendeur : deux mouvements
/// d'argent opposés, à deux moments différents, avec chacun son identifiant
/// chez le prestataire (`depositId` ici, `payoutId` là-bas).
model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  amount                Int // XAF entiers
  currency              String        @default("XAF")
  phoneNumber           String
  status                PaymentStatus @default(PENDING)
  provider              String        @default("MTN_MOMO")
  /// `depositId` pawaPay / `X-Reference-Id` MTN. Généré par NOUS avant l'appel
  /// au prestataire : c'est la clé d'idempotence côté PSP (un rejeu du même
  /// identifiant renvoie `DUPLICATE_IGNORED`, jamais un second débit).
  providerTransactionId String?
  metadata              Json          @default("{}")

  /// Opérateur visé, snapshot du choix fait à cette tentative. `Order.paymentMethod`
  /// porte l'intention initiale ; une seconde tentative peut viser un autre
  /// opérateur (plus de solde MTN, le client paie en Airtel).
  method PaymentMethod?

  /// Code d'échec du prestataire, tel quel. En colonne et non dans `metadata` :
  /// c'est ce qu'on filtre dans la file d'administration (« combien de PIN
  /// refusés cette semaine ? ») et un `Json` ne s'indexe pas.
  failureCode    String?
  failureMessage String?

  /// Instant de résolution. `updatedAt` servait de proxy pour le KPI « délai de
  /// validation » (`admin-payments.service.ts`) — il ment dès qu'une autre
  /// écriture touche la ligne.
  completedAt DateTime?

  /// Frais facturés par le prestataire sur cet encaissement, en XAF.
  /// **Charge de Lilia Food** : jamais déduit de ce que touche le vendeur.
  /// `null` tant que le prestataire ne l'a pas communiqué.
  ///
  /// ⚠️ `Int` : les prestataires annoncent leurs frais en décimal (« 12.50 »).
  /// L'arrondi doit se faire **à l'ingestion**, via `toXaf()`. La colonne le
  /// rend obligatoire au lieu de le laisser à la vigilance de l'appelant.
  collectionFeeXaf Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order          @relation(fields: [orderId], references: [id])
  refunds Refund[]
  events  PaymentEvent[]

  @@index([orderId])
  @@index([status]) // dashboard paiements filtrés par statut
  @@index([orderId, status]) // assertNoPendingPayment + cron d'expiration (fix M19)
  // Deux index UNIQUES PARTIELS complètent ceux-ci ; Prisma ne sait pas les
  // déclarer, ils sont créés en SQL par la migration `payment_unique_indexes` :
  //   · payments_order_pending_uq  ON (orderId) WHERE status = 'PENDING'
  //   · payments_provider_tx_uq    ON (provider, providerTransactionId)
  //                                WHERE providerTransactionId IS NOT NULL
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

/// Reversement au VENDEUR (payout), déclenché **manuellement par un
/// administrateur** quand la commande est prête.
///
/// Volontairement une entité distincte de `Payment` plutôt qu'un type de plus
/// sur celui-ci : les deux n'ont ni le même sens du flux d'argent, ni les mêmes
/// champs (un payout porte une commission figée et un bénéficiaire vendeur), ni
/// le même cycle de vie, ni le même identifiant chez le prestataire. Les fondre
/// obligerait chaque requête à filtrer sur un discriminant, et la première
/// requête qui l'oublierait mélangerait des encaissements et des reversements
/// dans un même total.
///
/// `@@unique([orderId])` porte **en base** la règle « un vendeur n'est payé
/// qu'une fois par commande » : c'est elle qui rend deux administrateurs
/// cliquant simultanément incapables de créer deux reversements. Une ligne
/// `FAILED` est supprimée avant de réessayer (cf. RestaurantPayoutService), ce
/// qui garde la contrainte intacte tout en autorisant une nouvelle tentative.
model RestaurantPayout {
  id           String     @id @default(cuid())
  orderId      String     @unique
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  // ─── Snapshot financier, figé à la création ────────────────────────────────
  // Ces cinq valeurs ne sont JAMAIS recalculées. Si le taux de commission passe
  // de 10 % à 12 % demain, un reversement d'hier doit continuer à dire 10 % —
  // c'est une pièce comptable, au même titre que `OrderItem.snapshotPrice`.
  /// Montant des produits revenant au vendeur (= `Order.subTotal`).
  /// Ni les frais de service client, ni la livraison n'y entrent.
  grossAmount       Int
  /// Proportion, pas un montant : reste `Float`.
  commissionPercent Float
  commissionAmount  Int
  /// Part de la livraison offerte par le vendeur (F3-02), retenue ici —
  /// snapshot de `Order.vendorDeliverySubsidyXaf`. `0` avant le mode PLATFORM.
  deliverySubsidyAmount Int @default(0)
  /// F3-06 — remboursements à la charge du vendeur, retenus sur ce reversement.
  refundDeductionAmount Int @default(0)
  /// `grossAmount - commissionAmount - deliverySubsidyAmount` — c'est CE
  /// montant qui part au prestataire.
  amount            Int
  currency          String @default("XAF")

  // ─── Destinataire, également figé ──────────────────────────────────────────
  // Le numéro peut changer dans la fiche du vendeur ; ce reversement-ci est
  // parti vers celui-ci.
  phoneNumber  String
  /// Opérateur du compte crédité, snapshot de `Restaurant.payoutProvider` au
  /// moment de l'envoi (`MTN_MOMO` / `AIRTEL_MONEY`). Le code technique attendu
  /// par le prestataire (`MTN_MOMO_COG`…) en est dérivé à l'appel : il dépend de
  /// la configuration du compte marchand et n'a pas à être figé ici.
  providerCode String

  status                PayoutStatus @default(PENDING)
  provider              String       @default("PAWAPAY")
  /// `payoutId` pawaPay — généré par nous, distinct du `depositId` de l'encaissement.
  providerPayoutId      String?
  /// Identifiant de la transaction chez l'opérateur, renvoyé par le prestataire.
  providerTransactionId String?

  failureCode    String?
  failureMessage String?

  /// Frais facturés par le prestataire sur ce reversement, en XAF.
  /// **Charge de Lilia Food** : jamais déduit du montant reversé au vendeur.
  /// `Int` pour la même raison que `Payment.collectionFeeXaf` : arrondir à
  /// l'ingestion, jamais au moment de lire.
  payoutFeeXaf Int?

  /// `User.id` de l'administrateur qui a déclenché le reversement.
  requestedBy String
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  metadata Json           @default("{}")
  events   PaymentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, status])
  @@index([status, requestedAt])
  @@index([restaurantId, completedAt])
  @@map("restaurant_payouts")
}

/// Cycle de vie d'un reversement.
///
/// `PENDING → SUCCESS | FAILED | CANCELLED`, et les états terminaux le sont
/// vraiment : un reversement réussi ne redevient jamais en attente. La règle
/// est portée par `PAYOUT_TRANSITIONS` (payout-state.machine.ts) et par les
/// `updateMany` conditionnés sur `PENDING`.
enum PayoutStatus {
  PENDING // envoyé au prestataire, en attente de confirmation
  SUCCESS // argent reçu par le vendeur — SEUL état où le vendeur est « payé »
  FAILED // refusé par le prestataire ou l'opérateur ; nouvelle tentative possible
  CANCELLED // abandonné avant aboutissement (arbitrage administratif)
}

/// Journal des signaux reçus d'un prestataire de paiement — callbacks et
/// réponses de réconciliation, pour les encaissements **et** les reversements.
///
/// Trois choses qu'aucune autre table ne donne :
///  · la preuve, en cas de litige, de ce que le prestataire a envoyé et quand —
///    `metadata` est écrasé à chaque écriture ;
///  · la détection des callbacks **hors ordre** (un `FAILED` qui arrive après un
///    `COMPLETED` sur la même transaction) ;
///  · le rejeu d'un callback perdu sans avoir à le redemander au prestataire.
///
/// En écriture seule : aucun endpoint ne la modifie ni ne la supprime.
model PaymentEvent {
  id String @id @default(cuid())

  /// L'un des deux est renseigné — jamais les deux. Tous deux nuls quand le
  /// callback ne correspond à aucune transaction connue (on garde quand même
  /// la trace : c'est le signal d'une fuite de configuration ou d'une attaque).
  paymentId String?
  payment   Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  payoutId  String?
  payout    RestaurantPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  kind       PaymentEventKind
  provider   String // 'PAWAPAY', 'MTN_MOMO', 'MANUAL'
  externalId String // depositId ou payoutId
  source     PaymentEventSource
  /// Statut brut annoncé par le prestataire ('COMPLETED', 'FAILED', 'ACCEPTED'…),
  /// conservé sans traduction : c'est ce qu'il a dit, pas ce qu'on en a compris.
  rawStatus  String
  /// Corps complet du signal. **Sans les en-têtes d'authentification.**
  payload    Json
  outcome    PaymentEventOutcome @default(APPLIED)
  receivedAt DateTime            @default(now())

  @@index([provider, externalId])
  @@index([paymentId, receivedAt])
  @@index([payoutId, receivedAt])
  @@index([outcome, receivedAt]) // supervision : compter doublons et incohérences
}

enum PaymentEventKind {
  COLLECTION
  PAYOUT
}

enum PaymentEventSource {
  WEBHOOK // callback du prestataire
  RECONCILIATION // interrogation par le cron
  CLIENT_POLL // déclenché par GET /payments/:id/status
  INITIATION // réponse synchrone à la demande d'opération
}

enum PaymentEventOutcome {
  APPLIED // a fait avancer la transaction
  DUPLICATE // état déjà atteint — rejeu sans effet
  IGNORED // transaction inconnue, ou statut non terminal
  MISMATCH // montant/devise incohérents ⇒ aucune transition, incident ouvert
}

enum DayOfWeek {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

// Mode de tarification de la livraison pour chaque restaurant
enum DeliveryPriceMode {
  FIXED // Prix fixe pour toutes les livraisons
  ZONE_BASED // Prix selon le quartier/zone
}

/// Qui fixe le prix de la course (Phase 3, F3-02).
enum DeliveryPricingMode {
  VENDOR_LEGACY
  PLATFORM
}

/// Part de la livraison offerte par le vendeur (Phase 3, F3-02).
enum DeliverySubsidyMode {
  NONE
  FIXED
  FREE_ABOVE
}

enum DeliveryTariffStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// Grille de livraison plateforme (Phase 3, F3-02). Une version publiée est
/// immuable : la modifier, c'est en publier une nouvelle — les commandes
/// passées gardent la leur (`Order.deliveryTariffVersion`).
model DeliveryTariff {
  id          String               @id @default(cuid())
  version     Int                  @unique
  status      DeliveryTariffStatus @default(DRAFT)
  /// Distance à vol d'oiseau × ce coefficient ≈ distance par la route.
  roadFactor  Float                @default(1.3)
  bands       DeliveryTariffBand[]
  overrides   DeliveryTariffOverride[]
  note        String?
  createdBy   String
  publishedAt DateTime?
  publishedBy String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
}

/// Tranche de distance : jusqu'à `maxKm` (inclus), le client paie `feeXaf`.
model DeliveryTariffBand {
  id       String         @id @default(cuid())
  tariffId String
  tariff   DeliveryTariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)
  maxKm    Float
  feeXaf   Int

  @@unique([tariffId, maxKm])
}

/// Prix explicite pour une paire de quartiers — prime sur les tranches.
model DeliveryTariffOverride {
  id               String         @id @default(cuid())
  tariffId         String
  tariff           DeliveryTariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)
  originQuartierId String
  origin           Quartier       @relation("TariffOverrideOrigin", fields: [originQuartierId], references: [id], onDelete: Cascade)
  destQuartierId   String
  dest             Quartier       @relation("TariffOverrideDest", fields: [destQuartierId], references: [id], onDelete: Cascade)
  feeXaf           Int

  @@unique([tariffId, originQuartierId, destQuartierId])
}

enum MenuType {
  COMBO // Menu compose de plusieurs produits existants
  PLAT_SPECIAL // Plat special du jour (produit auto-cree)
}

// Multi-vendeurs (Sprint A — LIL-111)
enum VendorType {
  RESTAURANT // Existant — comportement inchangé
  HOME_COOK // Pâtissiers, vendeurs maison, traiteurs
  BEVERAGE_SHOP // Sodas, jus, eaux, boissons importées non-alcoolisées
  BAKERY // Boulangeries, viennoiseries
  GROCERY // Réservé pour usage futur
}

enum ProductType {
  FOOD // Défaut — plats et repas (existant)
  BEVERAGE // Boissons (sodas, jus, eaux)
  ALCOHOL // Réservé futur — désactivé côté code (LIL-112)
  PASTRY // Pâtisseries, viennoiseries
  GROCERY // Épicerie sèche
}

enum StockMode {
  DAILY // Reset chaque nuit via cron (comportement actuel)
  PERMANENT // Stock réel, décrémentation pure, pas de reset
}

// Modèle pour les avis et notes des clients
model Review {
  id           String     @id @default(cuid())
  rating       Int // Note de 1 à 5
  comment      String? // Commentaire optionnel
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  order        Order?     @relation(fields: [orderId], references: [id])
  orderId      String?    @unique // Optionnel: lié à une commande spécifique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // `@@unique([userId, restaurantId])` a été RETIRÉ (audit du 28/08/2026) : il
  // interdisait structurellement plus d'un avis par vendeur et par client, ce
  // qui contredisait le flux « un avis par commande livrée » qu'implémente
  // ReviewsService. L'unicité utile est déjà portée par `orderId @unique` ;
  // pour les avis sans commande, c'est le service qui garde l'unicité.
  @@index([restaurantId])
  @@index([userId])
  @@index([restaurantId, rating]) // stats agrégées (groupBy) — fix M19 / P0
}

// Zones de livraison avec prix personnalisé par restaurant
model DeliveryZone {
  id           String         @id @default(cuid())
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  zoneName     String // Ex: "Zone 1", "Centre-ville", etc.
  fee          Int // Prix de livraison pour cette zone, en XAF entiers
  quartiers    QuartierZone[] // Quartiers inclus dans cette zone
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  /// Cible de la clé étrangère **composite** portée par `QuartierZone` — même
  /// idiome que `Category` pour `Product`. C'est elle qui rend structurellement
  /// impossible qu'un rattachement porte un `restaurantId` différent de celui
  /// de sa zone, et donc qui rend la contrainte d'unicité ci-dessous fiable.
  @@unique([id, restaurantId])
  @@index([restaurantId])
}

// Liste des quartiers de Brazzaville
model Quartier {
  id          String          @id @default(cuid())
  nom         String          @unique // Ex: "Bacongo", "Poto-Poto", "Talangaï"
  ville       String          @default("Brazzaville")
  zones       QuartierZone[]
  adresses    Adresses[]
  restaurants Restaurant[] // Vendeurs implantés dans ce quartier
  /// Livreurs affectés à ce quartier (many-to-many implicite).
  drivers     DriverProfile[] @relation("DriverZones")
  /// Prix de livraison explicites (grille plateforme, F3-02).
  tariffOverridesFrom DeliveryTariffOverride[] @relation("TariffOverrideOrigin")
  tariffOverridesTo   DeliveryTariffOverride[] @relation("TariffOverrideDest")
  createdAt   DateTime        @default(now())

  /// Centroïde du quartier — repli quand une adresse n'a pas de position.
  ///
  /// `null` est un état **normal et assumé** : le géocodage de Google ne
  /// reconnaît pas tous les quartiers de Brazzaville (7 des 26 renvoient le
  /// centre-ville générique, ce qui les rendrait tous identiques). Plutôt que
  /// de semer un point faux, on laisse vide et un administrateur complète via
  /// `PATCH /quartiers/:id/centroid`. Un centroïde absent dégrade proprement
  /// en `LocationPrecision.UNKNOWN`.
  latitude  Float?
  longitude Float?
}

// Table de liaison entre quartiers et zones de livraison
model QuartierZone {
  id         String   @id @default(cuid())
  quartier   Quartier @relation(fields: [quartierId], references: [id], onDelete: Cascade)
  quartierId String

  /// Zone tarifaire, jointe sur `(deliveryZoneId, restaurantId)`.
  ///
  /// La relation est **composite** pour que PostgreSQL garantisse lui-même que
  /// `restaurantId` est bien celui de la zone. Sans cette garantie, la colonne
  /// serait une dénormalisation qui pourrait mentir, et la contrainte
  /// d'unicité qui s'appuie dessus ne protégerait rien.
  deliveryZone   DeliveryZone @relation(fields: [deliveryZoneId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  deliveryZoneId String
  /// Vendeur propriétaire de la zone — recopié depuis elle, jamais saisi.
  restaurantId   String

  @@unique([quartierId, deliveryZoneId])
  /// **Un quartier, un seul tarif par vendeur** (fix L-6, audit du 05/09/2026).
  ///
  /// Rien n'empêchait jusqu'ici un quartier d'appartenir à deux zones du même
  /// vendeur : `@@unique([quartierId, deliveryZoneId])` interdit le doublon
  /// dans **une** zone, pas l'appartenance à deux zones différentes. Or
  /// `QuartiersService.calculateDeliveryFee` retourne la **première** zone
  /// trouvée en parcourant un `include` sans `orderBy` — l'ordre des lignes
  /// n'étant pas garanti par PostgreSQL, deux clients du même quartier
  /// pouvaient payer deux tarifs différents.
  ///
  /// La règle vit en base et non dans un `if` : un `if` ne protège que le
  /// chemin qui le traverse, et il y en a trois (création, mise à jour,
  /// ajout de quartiers) plus les scripts d'administration.
  @@unique([restaurantId, quartierId])
  @@index([quartierId])
  @@index([deliveryZoneId])
}

