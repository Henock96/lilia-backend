/// F3-03 — congé ou fermeture datée d'un vendeur (« du 24 au 31 décembre »).
/// Se termine seule ; ne touche pas aux commandes déjà payées (R-03.4).
model VendorClosure {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime // CHECK "endsAt" > "startsAt"
  reason       String?
  createdBy    String
  createdAt    DateTime   @default(now())

  @@index([restaurantId, endsAt])
}

/// F3-03 — jour férié de la plateforme (Congo). Les vendeurs dont
/// `closedOnHolidays` est vrai sont fermés ce jour-là (heure de Brazzaville).
model PublicHoliday {
  date      DateTime @id @db.Date
  label     String
  country   String   @default("CG")
  createdAt DateTime @default(now())
}

model OperatingHours {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  dayOfWeek    DayOfWeek
  openTime     String // "HH:mm"
  closeTime    String // "HH:mm"
  isClosed     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@index([dayOfWeek])
}

enum DiscountType {
  FIXED // montant fixe : -500 FCFA
  PERCENT // pourcentage : -10%
  FREE_DELIVERY // livraison gratuite
}

model PromoCode {
  id          String  @id @default(cuid())
  code        String  @unique // "BIENVENUE500" — toujours uppercase
  description String? // affiché dans l'app : "500 FCFA offerts sur ta 1ère commande"

  discountType  DiscountType
  /// ⚠️ **Volontairement `Float`, contrairement à tous les autres montants.**
  ///
  /// Cette colonne porte deux choses selon `discountType` : un montant XAF si
  /// `FIXED` (500), un **pourcentage** si `PERCENT` (10, ou 7,5). La passer en
  /// `Int` interdirait silencieusement une campagne à 7,5 % — une capacité
  /// commerciale réelle, supprimée au nom d'une règle qui ne vaut que pour la
  /// moitié des lignes.
  ///
  /// L'intégrité du cas `FIXED` est tenue par le DTO (`@ValidateIf` + `@IsInt`),
  /// là où le discriminant est connu.
  discountValue Float
  maxDiscount   Int? // plafond si PERCENT, en XAF

  minOrderAmount  Int  @default(0) // montant minimum pour activer le code, en XAF
  maxUsageTotal   Int? // null = illimité — ex: 100 pour une campagne limitée
  maxUsagePerUser Int  @default(1) // 1 = 1 fois par utilisateur

  firstOrderOnly Boolean @default(false) // réservé aux nouveaux clients
  isActive       Boolean @default(true)

  // Restriction par restaurant (null = toute la plateforme)
  restaurantId String?
  restaurant   Restaurant? @relation("RestaurantPromoCodes", fields: [restaurantId], references: [id])
  // `discountAmount` a été SUPPRIMÉ de ce modèle (03/09/2026). Dupliqué depuis
  // `Order.discountAmount`, il n'était NI lu NI écrit depuis sa création :
  // toutes les lignes portaient le défaut `0`. Une colonne qui ressemble à un
  // montant sans en être un finit par être lue de bonne foi — c'est un piège,
  // pas une donnée.
  startsAt     DateTime    @default(now())
  expiresAt    DateTime? // null = pas d'expiration

  /// F3-06 — avoir nominatif : seul ce client peut utiliser le code (R-06.6).
  assignedUserId String?
  assignedUser   User?        @relation("AssignedPromoCodes", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// Qui finance la remise. Les avoirs sont à la charge de la plateforme ;
  /// `VENDOR` servira aux campagnes vendeur (F3-11).
  fundingSource  PromoFunding @default(PLATFORM)

  usages    PromoUsage[]
  orders    Order[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([code])
  @@index([isActive, startsAt, expiresAt])
  @@index([restaurantId])
  @@index([assignedUserId])
}

model PromoUsage {
  id              String    @id @default(cuid())
  promoCode       PromoCode @relation(fields: [promoCodeId], references: [id])
  promoCodeId     String
  userId          String
  user            User      @relation("UserPromoUsages", fields: [userId], references: [id])
  orderId         String    @unique // 1 promo max par commande
  discountApplied Int // montant réellement déduit (snapshot), en XAF
  usedAt          DateTime  @default(now())

  @@index([promoCodeId])
  @@index([userId])
}

model Favorite {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@index([userId])
}

// ============================================================
// Incidents — tracker opérationnel (annulations, retards, plaintes...)
// ============================================================

enum IncidentType {
  ORDER_CANCELLED // commande annulée
  ORDER_DELAYED // retard de livraison
  PAYMENT_FAILED // échec paiement
  DRIVER_NO_SHOW // livreur ne s'est pas présenté
  DRIVER_ACCIDENT // accident livreur
  CUSTOMER_COMPLAINT // plainte client
  RESTAURANT_CLOSED // restaurant fermé hors horaires
  STOCK_ISSUE // problème stock / produit indisponible
  WRONG_DELIVERY // mauvaise livraison
  REFUND_REQUEST // demande remboursement
  OTHER
  /// F3-04 — une file « À traiter » a franchi son seuil (ouvert et résolu par le système).
  OPS_SLA_BREACH
  /// F3-04 — un taux sur fenêtre glissante a franchi son seuil (ex. échec de paiement).
  METRIC_ANOMALY
  /// F3-06 — réclamation client sur une commande livrée (articles, fil, issue).
  CUSTOMER_CLAIM
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Boîte d'envoi transactionnelle (fix H7 — audit du 28/08/2026).
///
/// Le seul signal qui prévenait un vendeur qu'une commande était arrivée était
/// un push FCM émis via `EventEmitter2` **en mémoire**, après le commit :
///  - process tué entre les deux ⇒ événement perdu, définitivement, sans trace ;
///  - `@nestjs/event-emitter` applique `suppressErrors ?? true` ⇒ une erreur de
///    listener est loguée puis avalée ;
///  - vendeur sans token FCM ⇒ un simple `logger.warn` (cas déjà observé en
///    production sur les comptes ADMIN).
///
/// Une commande payée pouvait donc n'être jamais vue. La ligne est désormais
/// écrite **dans la transaction de checkout** : si la commande existe,
/// l'obligation de notifier existe aussi. Un worker la dépile avec backoff, et
/// escalade en SMS quand le push ne suffit pas.
model OutboxEvent {
  id            String            @id @default(cuid())
  type          String // 'order.created', …
  aggregateId   String // orderId, en général
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now())
  lastError     String?           @db.Text
  escalatedAt   DateTime? // date d'envoi du SMS de secours
  processedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateId, type])
}

enum OutboxEventStatus {
  PENDING // à traiter (ou à re-traiter)
  SENT // acquitté
  FAILED // abandonné après épuisement des tentatives
}

/// Remboursement d'une commande payée puis annulée (fix H5 — audit 28/08/2026).
///
/// Avant : le système restituait stock, points et code promo, mais la ligne
/// `Payment` restait `SUCCESS`, aucune entité ne matérialisait la dette envers
/// le client, aucune tâche admin n'était créée, et le `refundAmount` calculé
/// (`total >= 1000 ? total : 0`) n'alimentait qu'un message de notification —
/// une règle « non remboursable sous 1 000 XAF » qui n'apparaissait ni dans les
/// CGU ni dans l'app. Chaque annulation après paiement était donc un litige
/// non traçable.
model Refund {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId   String?
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount      Int // montant dû au client, en XAF
  status      RefundStatus @default(PENDING)
  reason      String       @db.Text
  requestedBy String? // User.id à l'origine de l'annulation
  processedBy String? // User.id de l'admin qui a exécuté le virement
  processedAt DateTime?
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // ─── Exécution du virement au client (septembre 2026) ────────────────────
  //
  // Jusqu'ici cette table était un **registre déclaratif** : un administrateur
  // passait le statut à `COMPLETED` à la main, et rien ne prouvait qu'un franc
  // avait bougé. C'était cohérent avec le mode `MANUAL` d'origine ; ça ne l'est
  // plus depuis que le rail existe (`PawaPayProvider.createPayout`, déjà
  // utilisé pour les vendeurs). Un remboursement était le dernier mouvement
  // d'argent sans trace prestataire.

  /// Prestataire qui exécute le virement. `null` = remboursement traité hors
  /// application (espèces, virement à la main) — le mode déclaratif reste
  /// possible, il n'est simplement plus le seul.
  provider String?

  /// Identifiant du virement chez le prestataire, **généré par nous avant
  /// l'appel**. C'est la clé d'idempotence : un rejeu du même identifiant
  /// renvoie `DUPLICATE_IGNORED`, jamais un second virement. Même rôle que
  /// `Payment.providerTransactionId` et `RestaurantPayout.providerPayoutId`.
  providerRefundId String? @unique

  /// Référence rendue par le prestataire une fois le virement abouti.
  providerTransactionId String?

  /// Destination du remboursement, figée à l'exécution.
  ///
  /// ⚠️ Elle est recopiée de `Payment.phoneNumber` — **le numéro depuis lequel
  /// le client a payé** — et jamais saisie par un administrateur. Rembourser
  /// ailleurs que sur l'origine des fonds transformerait cette file en outil de
  /// détournement : il suffirait d'annuler une commande et de désigner un autre
  /// numéro.
  phoneNumber String?

  /// Opérateur visé, dérivé de `Payment.method`.
  payoutProvider PayoutProvider?

  failureCode    String?
  failureMessage String?

  // ─── Remboursements partiels (F3-06, septembre 2026) ─────────────────────
  //
  // `@@unique([orderId])` a disparu : une commande peut être remboursée en
  // plusieurs fois (article manquant, puis geste commercial). Deux garde-fous
  // le remplacent, en SQL — Prisma ne sait pas exprimer un index partiel :
  //
  //  - `Refund_orderId_inflight_uq` : au plus UN remboursement `PENDING` ou
  //    `PROCESSING` par commande (R-06.1) ;
  //  - `Refund_orderId_auto_uq` : au plus UN remboursement « total »
  //    automatique (annulation, refus ou silence du vendeur, échec de
  //    livraison) — c'est lui qui rend l'outbox `order.refund_due` rejouable
  //    sans rembourser deux fois.
  //
  // `lines` vide = remboursement total historique (antérieur à F3-06, ou
  // ouvert automatiquement) ; on ne fabrique pas de lignes synthétiques.

  reasonCode RefundReasonCode @default(ORDER_CANCELLED)
  /// Qui supporte la perte (R-06.4). `VENDOR` = déduit de son reversement.
  bearer     RefundBearer     @default(PLATFORM)
  /// Réclamation à l'origine du remboursement, s'il y en a une.
  incidentId String?
  incident   Incident?        @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  lines      RefundLine[]

  @@index([orderId])
  @@index([status, createdAt])
  @@index([incidentId])
}

/// Ligne d'un remboursement partiel (F3-06, R-06.3).
///
/// Le montant d'une ligne `ITEM` est `snapshotPrice × quantity` — le prix
/// figé à la commande, jamais relu sur le catalogue. Il est **recopié** ici :
/// un remboursement passé ne se recalcule pas.
model RefundLine {
  id          String         @id @default(cuid())
  refundId    String
  refund      Refund         @relation(fields: [refundId], references: [id], onDelete: Cascade)
  kind        RefundLineKind
  orderItemId String?
  orderItem   OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int?
  amountXaf   Int
  createdAt   DateTime       @default(now())

  @@index([refundId])
  @@index([orderItemId])
}

enum RefundStatus {
  PENDING // à traiter par l'admin
  PROCESSING // virement en cours
  COMPLETED // client remboursé
  REJECTED // refus motivé (fraude, commande déjà consommée…)
}

/// Motif d'un remboursement (F3-06). Les quatre premiers sont « automatiques »
/// (remboursement total, au plus un par commande) ; les autres naissent du
/// composeur de l'administration.
enum RefundReasonCode {
  ORDER_CANCELLED
  VENDOR_REJECTED
  VENDOR_TIMEOUT
  DELIVERY_FAILED
  MISSING_ITEM
  WRONG_ITEM
  DAMAGED
  LATE
  GOODWILL
  OTHER
}

/// Qui supporte un remboursement (R-06.4).
enum RefundBearer {
  VENDOR // retenu sur le reversement du vendeur
  PLATFORM // coût Lilia
  DRIVER // noté, réglé hors système
}

enum RefundLineKind {
  ITEM
  DELIVERY_FEE
  SERVICE_FEE
  GOODWILL
}

/// Visibilité d'un message de réclamation.
enum MessageVisibility {
  ALL // client compris
  STAFF_ONLY // support et vendeur, jamais le client
}

/// Financement d'un code promo.
enum PromoFunding {
  PLATFORM
  VENDOR
}

/// Message d'un fil de réclamation (F3-06).
model IncidentMessage {
  id          String            @id @default(cuid())
  incidentId  String
  incident    Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId    String
  author      User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorRole  Role
  visibility  MessageVisibility @default(ALL)
  body        String            @db.Text
  /// URLs d'images (Cloudinary uniquement, vérifié par le DTO).
  attachments Json              @default("[]")
  createdAt   DateTime          @default(now())

  @@index([incidentId, createdAt])
}

/// Journal d'audit des actions d'administration (audit du 28/08/2026).
///
/// `updateUserRole`, `banUser`, `suspendVendor` et `confirmManualPayment`
/// modifient des droits ou de l'argent et ne laissaient qu'une ligne de log
/// applicatif — perdue à la rotation, non interrogeable, non opposable. Cette
/// table est en écriture seule côté application : aucun endpoint ne la modifie
/// ni ne la supprime.
model AdminAuditLog {
  id         String           @id @default(cuid())
  actorId    String // User.id de l'administrateur qui agit
  actor      User             @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     AdminAuditAction
  targetType String // "User", "Restaurant", "Payment", "Order"…
  targetId   String
  reason     String?          @db.Text
  metadata   Json? // avant/après, montants, références
  createdAt  DateTime         @default(now())

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([action, createdAt(sort: Desc)])
}

enum AdminAuditAction {
  // Reversement vendeur déclenché à la main (août 2026). Chaque envoi d'argent
  // à un tiers doit laisser une trace nominative opposable, au même titre que
  // PAYMENT_CONFIRMED.
  PAYOUT_REQUESTED
  PAYOUT_RETRIED
  PAYOUT_CANCELLED
  VENDOR_PAYOUT_ACCOUNT_UPDATED
  USER_ROLE_CHANGED
  USER_BANNED
  USER_UNBANNED
  // Cycle de vie d'un compte livreur (septembre 2026). Créer un livreur, c'est
  // donner à quelqu'un l'accès aux adresses et aux téléphones des clients :
  // au même titre qu'un changement de rôle, la décision doit rester nominative.
  DRIVER_CREATED
  DRIVER_UPDATED
  DRIVER_ACTIVATED
  DRIVER_DEACTIVATED
  /// Versement au livreur enregistré — l'argent a été remis HORS application.
  DRIVER_SETTLEMENT_RECORDED
  DRIVER_SETTLEMENT_CANCELLED
  // Mise en ordre et mise en avant du catalogue — décisions éditoriales qui
  // changent ce que voit chaque client sur la page d'accueil.
  VENDOR_DISPLAY_ORDER_CHANGED
  VENDOR_FEATURED_TOGGLED
  VENDOR_CREATED
  VENDOR_ACTIVATED
  VENDOR_COMMISSION_CHANGED
  // Écriture au catalogue d'un vendeur par un administrateur : l'admin peut
  // désormais créer produits et menus au nom d'un vendeur (sans quoi il ne
  // pouvait pas amorcer une boutique), ce qui doit rester traçable.
  VENDOR_CATALOG_EDITED
  VENDOR_APPROVED
  VENDOR_SUSPENDED
  VENDOR_ACTIVE_TOGGLED
  VENDOR_PAUSED
  ORDER_FAILURE_CONCLUDED
  PUBLIC_HOLIDAY_UPDATED
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
  REFUND_CREATED
  REFUND_UPDATED
  ORDER_STATUS_FORCED
  /// Écriture manuelle sur un solde de fidélité. Un point vaut de l'argent :
  /// le créditer à la main est un mouvement financier, pas un réglage.
  LOYALTY_ADJUSTED
  /// Changement du barème plateforme — dont la **valeur du point**, qui
  /// revalorise d'un coup tout le passif déjà distribué. C'est le geste le plus
  /// lourd de conséquences du back-office, il ne laissait aucune trace.
  PLATFORM_SETTINGS_CHANGED
  /// Arbitrage humain d'une récompense de parrainage mise en revue.
  REFERRAL_REWARD_REVIEWED
  /// Publication d'une grille de livraison (F3-02) : elle fixe d'un coup ce
  /// que paient tous les clients et ce que touchent tous les livreurs.
  DELIVERY_TARIFF_PUBLISHED
  /// F3-06 — avoir nominatif émis sur une réclamation.
  CLAIM_VOUCHER_ISSUED
  /// F3-06 — réclamation refusée (motif communiqué au client).
  CLAIM_REJECTED
}

model Incident {
  id           String           @id @default(cuid())
  type         IncidentType
  severity     IncidentSeverity @default(MEDIUM)
  status       IncidentStatus   @default(OPEN)
  title        String
  description  String           @db.Text
  resolution   String?          @db.Text
  // Liens optionnels — pas de FK car relationMode = prisma
  orderId      String?
  riderId      String? // User.id avec role LIVREUR
  restaurantId String?
  reportedBy   String? // User.id de qui a remonté (admin/system)
  resolvedBy   String? // User.id qui a résolu
  metadata     Json? // contexte additionnel (montants, refs paiement, etc.)
  /// F3-04 — une cause = un incident ouvert au plus (« ops:acceptance_late:<orderId> »).
  /// Garanti par l'index unique **partiel** `Incident_dedupKey_open_uq`
  /// (status OPEN/IN_PROGRESS), posé en SQL : Prisma ne sait pas l'exprimer.
  dedupKey     String?
  /// Résolu par le système quand sa cause a disparu (R-04.2).
  autoResolved Boolean          @default(false)
  /// F3-06 — fil de discussion d'une réclamation.
  messages     IncidentMessage[]
  /// F3-06 — remboursements décidés sur cette réclamation.
  refunds      Refund[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  resolvedAt   DateTime?

  @@index([status, severity])
  @@index([type, createdAt])
  @@index([orderId])
  @@index([riderId])
  @@index([restaurantId])
}

model PlatformSettings {
  id String @id @default("singleton")

  /// FRAIS DE SERVICE CLIENT — payés **en plus** par le client, ajoutés au
  /// panier (`total = subTotal + deliveryFee + serviceFee - discount`).
  /// Couvrent le fonctionnement, la technique, les frais de paiement et le
  /// support de Lilia Food.
  serviceFeePercent Float @default(8)

  /// COMMISSION VENDEUR par défaut — retenue **sur** le vendeur au moment du
  /// reversement, jamais payée par le client.
  /// `Restaurant.commissionPercent` la surcharge par vendeur quand il est non
  /// nul (Restaurant A à 10 %, B à 8 %, C à 12 %).
  ///
  /// ⚠️ Ne jamais écrire ce taux en dur dans le code : il n'est pas arrêté, et
  /// il est appelé à varier par vendeur. Le calcul passe TOUJOURS par
  /// `RestaurantPayoutService.resolveCommissionPercent`.
  restaurantCommissionPercent Float @default(10)

  /// PART DU LIVREUR sur les frais de livraison, en pourcentage.
  ///
  /// ⚠️ Ces deux champs portent la part **du livreur**, jamais celle de Lilia.
  /// Le préfixe dit à qui est la part, le suffixe dit quel type de livreur.
  /// Un nom comme `liliaDriverSharePercent` se lirait « la part de Lilia » tout
  /// en contenant 35 : c'est exactement l'inversion que ce modèle doit rendre
  /// impossible à commettre.
  ///
  /// La part de Lilia n'est PAS stockée : elle vaut `base − driverPay`. Un
  /// résidu ne peut pas diverger de son complément, deux colonnes si.
  ///
  /// Surchargés par livreur via `DriverProfile.driverSharePercent`.
  /// N'affectent que les courses **futures** : le taux est figé sur chaque
  /// course à l'acceptation.
  driverSharePercentLilia       Float @default(35)
  driverSharePercentIndependent Float @default(65)

  /// BARÈME DE FIDÉLITÉ — refondu en septembre 2026.
  ///
  /// Le gain n'est plus proportionnel au montant : une commande livrée vaut un
  /// forfait, quel que soit son montant. `loyaltyPointsPer100Xaf` a donc été
  /// **supprimé** plutôt que détourné — un champ dont le nom ne décrit plus le
  /// calcul est un piège pour qui reprend le code.
  ///
  /// ⚠️ `loyaltyPointValueXaf` est lu **au moment de la dépense**, jamais figé à
  /// l'acquisition : le modifier revalorise instantanément tout le passif déjà
  /// distribué. Ne jamais le changer sans exécuter au préalable
  /// `scripts/db/redenominate-loyalty.js` (voir `docs/LOYALTY.md`).
  loyaltyPointsPerOrder Int @default(1)
  loyaltyPointValueXaf  Int @default(50)
  loyaltyMinRedemption  Int @default(1)

  /// Récompense du parrain à la première commande **livrée** de son filleul.
  /// Le bonus de bienvenue du filleul (`referredBonusPoints`) a été supprimé :
  /// il payait une inscription, pas un achat.
  referrerBonusPoints Int @default(1)

  maintenanceMode    Boolean @default(false)
  maintenanceMessage String?

  /// PARC INSTALLÉ — pilotage des mises à jour des applications mobiles.
  ///
  /// Les binaires publiés sur les stores ne peuvent pas être rappelés : une
  /// version qui affiche un mauvais numéro de paiement, ou qui parle un
  /// contrat d'API qu'on vient de changer, reste installée chez le client
  /// jusqu'à ce qu'il décide de la mettre à jour. Ces champs sont le seul
  /// levier dont dispose la plateforme pour agir dessus sans release.
  ///
  /// Format attendu : `major.minor.patch` avec `+build` optionnel
  /// (« 1.3.0 », « 1.3.0+41 »). Les clients parsent **strictement** : une
  /// valeur mal formée est ignorée et traitée comme « aucune contrainte ».
  /// C'est délibéré — une faute de frappe ne doit pas bloquer le parc.
  /// Laisser `null` désactive le mécanisme correspondant.

  /// En dessous de cette version, l'application se bloque et exige une mise à
  /// jour. ⚠️ À manier avec précaution : c'est le seul réglage de cette table
  /// qui peut empêcher un client de commander. Ne l'utiliser que pour une
  /// faille de sécurité ou une rupture de contrat d'API — jamais pour pousser
  /// une nouveauté, ce à quoi sert `latestAppVersion`.
  minAppVersion String?

  /// Dernière version publiée. Au-dessus de la version installée, l'app
  /// propose la mise à jour et laisse repousser.
  latestAppVersion String?

  /// Liens de store. `null` ⇒ les applications retombent sur les URL par
  /// défaut compilées dans le binaire. Les renseigner permet de rediriger vers
  /// une fiche de test ou un store alternatif sans release.
  updateUrlAndroid String?
  updateUrlIos     String?

  /// Message affiché dans la boîte de dialogue. Sert à dire *pourquoi* la mise
  /// à jour compte — « corrige un problème de paiement Airtel » convainc mieux
  /// qu'un libellé générique.
  updateMessage String?

  // ── Acceptation vendeur (Phase 3, F3-01) ─────────────────────────────────

  /// Interrupteur de mise en service. Tant qu'il est faux, `PAYER →
  /// EN_PREPARATION` reste le geste nominal (acceptation implicite) et aucune
  /// commande n'expire : les applications vendeur déjà installées ne
  /// connaissent pas encore `ACCEPTEE`. À basculer après publication.
  orderAcceptanceRequired Boolean @default(false)

  /// Délai d'acceptation d'une commande payée (décision D1 du 23/09/2026).
  vendorAcceptanceTimeoutMinutes Int @default(8)

  /// Rappel SMS au vendeur, en minutes AVANT l'échéance.
  vendorAcceptanceReminderLeadMinutes Int @default(3)

  /// Délai d'acceptation d'une précommande, borné par son heure de livraison.
  preorderAcceptanceHours Int @default(2)

  /// Remboursement exécuté sans geste humain quand le vendeur refuse ou laisse
  /// expirer (décision D2). Un paiement `MANUAL` reste dans la file admin.
  autoRefundVendorFault Boolean @default(true)

  // ── Tarification de la livraison (Phase 3, F3-02) ─────────────────────────

  /// `VENDOR_LEGACY` : frais fixés par le vendeur (historique). `PLATFORM` :
  /// grille plateforme publiée. Basculé après publication d'une grille.
  deliveryPricingMode DeliveryPricingMode @default(VENDOR_LEGACY)

  updatedAt DateTime @updatedAt
}

/// Comment l'argent a été remis au livreur.
///
/// Déclaratif : le versement se fait **hors application** (espèces de la main à
/// la main, virement Mobile Money passé à la main). Un enum plutôt qu'un texte
/// libre — un champ de saisie libre dans une pièce financière devient
/// illisible en agrégat au bout de trois mois.
enum DriverSettlementMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

/// État d'un règlement livreur.
///
/// ⚠️ Deux valeurs seulement, et **aucun état d'attente**. Un règlement n'est
/// enregistré qu'APRÈS que l'argent a été remis : il n'y a donc rien à
/// attendre. Un `PENDING` aurait décrit un moment qui n'existe pas dans ce
/// modèle, et son vrai effet aurait été de verrouiller les courses d'un livreur
/// si personne ne revenait le confirmer — un administrateur interrompu suffit.
///
/// `CANCELLED` couvre la saisie erronée, pas un flux : il libère les courses.
enum DriverSettlementStatus {
  PAID
  CANCELLED
}

/// Ce que Lilia Food a versé à un livreur, pour un ensemble de courses.
///
/// ## Un registre de dette, pas un rail de paiement
///
/// Aucun virement n'est déclenché par cette table (décision D-6 du 19/09/2026).
/// Le rail automatique est éteint en production (`PAYMENT_MODE=MANUAL`,
/// `ManualProvider.supportsPayout = false`), la capacité PAYOUT de pawaPay n'a
/// jamais été validée, et aucun livreur n'a de compte de versement enregistré.
/// Construire dessus aurait produit du code incapable de tourner.
///
/// De `Refund` on ne reprend qu'une chose, la seule qui se transpose : un
/// statut terminal signifie « **un humain** a remis l'argent », jamais « le
/// système l'a envoyé ». Le reste diffère — un remboursement est 1:1 avec une
/// commande, un règlement couvre N courses.
///
/// ## Enregistré en UN temps, avec une coupure explicite
///
/// Le montant dû se consulte par une **lecture pure** qui ne crée rien et ne
/// verrouille rien. Le règlement, lui, n'est écrit qu'une fois l'argent remis,
/// et il porte la date de coupure de l'aperçu consulté.
///
/// ⚠️ `coveredUntil` doit venir de l'appelant, **jamais** d'un `now()` au
/// moment de l'écriture : entre l'instant où l'administrateur lit « 3 500 XAF »
/// et celui où il enregistre, le livreur a pu terminer deux courses. Les
/// absorber dans un montant déjà convenu le sous-paierait, en silence.
///
/// ## Pourquoi par période et non par course
///
/// Une course rapporte ~350 XAF. Régler à l'unité multiplierait les frais
/// Mobile Money pour des sommes dérisoires. `RestaurantPayout` ne pouvait pas
/// l'exprimer : son `orderId @unique` lie une ligne à une seule commande.
///
/// ## Ce qui rend le double paiement impossible
///
/// `Delivery.driverSettlementId`. Une course rattachée n'est plus éligible, et
/// c'est la **base** qui l'arbitre. Le rattachement passe par un
/// `updateMany WHERE driverSettlementId IS NULL` dans la transaction
/// d'enregistrement : deux administrateurs simultanés ne peuvent pas couvrir
/// deux fois les mêmes courses.
model DriverSettlement {
  id       String @id @default(cuid())
  driverId String
  driver   User   @relation("DriverSettlements", fields: [driverId], references: [id], onDelete: Restrict)

  // ─── Snapshot figé à l'enregistrement ───────────────────────────────────
  // Jamais recalculé : c'est une pièce comptable. Recompter les courses à la
  // lecture ferait varier un règlement passé — ce que la commission vendeur a
  // coûté pendant des mois.

  /// Somme des `Delivery.driverPayXaf` des courses couvertes, en XAF.
  amountXaf    Int
  /// Nombre de courses couvertes, figé. Redondant avec la relation, et voulu :
  /// il dit ce qui a été arrêté même si une course était détachée ensuite.
  courseCount  Int
  /// Première course couverte (`min(deliveredAt)`), pour l'affichage.
  periodStart  DateTime
  /// Coupure **choisie par l'appelant**. Aucune course livrée après cet
  /// instant n'entre dans ce règlement.
  coveredUntil DateTime
  currency     String   @default("XAF")

  status DriverSettlementStatus @default(PAID)

  /// Comment l'argent a été remis.
  method    DriverSettlementMethod
  /// Référence externe : numéro de transaction Mobile Money, numéro de reçu.
  /// Seule trace opposable d'un versement fait hors application.
  reference String?
  note      String?

  /// Instant déclaré de la remise. Distinct de `recordedAt` : un règlement
  /// d'hier peut être saisi ce matin, et confondre les deux fausserait toute
  /// lecture par période.
  paidAt DateTime

  /// `User.id` de l'administrateur — pas de FK, comme `requestedBy` sur les
  /// reversements vendeurs.
  recordedBy String
  recordedAt DateTime @default(now())

  cancelledBy  String?
  cancelledAt  DateTime?
  cancelReason String?

  updatedAt DateTime @updatedAt

  deliveries Delivery[]

  @@index([driverId, status])
  @@index([driverId, paidAt])
  @@map("driver_settlements")
}
